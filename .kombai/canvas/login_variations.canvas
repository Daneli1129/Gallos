      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=JetBrains+Mono:wght@400&display=swap');\n\n  :root {\n    --gold: #C9A84C;\n    --gold-bright: #E8C97A;\n    --gold-dim: #A8862B;\n    --black: #000000;\n    --gray-dark: #0a0a0a;\n    --text-main: #FFFFFF;\n    --text-dim: #A3A3A3;\n  }\n\n  body {\n    background-color: var(--black);\n    color: var(--text-main);\n    font-family: 'Outfit', sans-serif;\n    margin: 0;\n    overflow: hidden;\n    height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* --- Background Motif --- */\n  .bg-container {\n    position: fixed;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n  }\n\n  .bg-image {\n    position: absolute;\n    inset: 0;\n    background-image: url('/api/local/images/shared/login_background.png');\n    background-size: cover;\n    background-position: center;\n    opacity: 0.15;\n    filter: grayscale(1) brightness(0.8);\n  }\n\n  .bg-gradient {\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle at center, transparent 0%, var(--black) 85%);\n  }\n\n  /* --- Light Sweep --- */\n  .light-sweep {\n    position: fixed;\n    top: -50%;\n    left: -50%;\n    width: 200%;\n    height: 200%;\n    background: linear-gradient(\n      115deg,\n      transparent 40%,\n      rgba(201, 168, 76, 0.08) 48%,\n      rgba(232, 201, 122, 0.15) 50%,\n      rgba(201, 168, 76, 0.08) 52%,\n      transparent 60%\n    );\n    z-index: 1;\n    pointer-events: none;\n    transform: translateX(-100%);\n  }\n\n  /* --- Main Container --- */\n  .login-wrapper {\n    position: relative;\n    z-index: 10;\n    width: 100%;\n    max-width: 320px;\n    padding: 2rem;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .brand-logo {\n    margin-bottom: 3rem;\n    text-align: center;\n    opacity: 0;\n  }\n\n  .brand-logo h1 {\n    font-size: 2.25rem;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: -0.04em;\n    margin: 0;\n    background: linear-gradient(to bottom, var(--text-main), var(--text-dim));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .brand-logo span {\n    font-size: 0.75rem;\n    font-weight: 300;\n    letter-spacing: 0.6em;\n    text-transform: uppercase;\n    color: var(--gold);\n    display: block;\n    margin-top: 0.25rem;\n  }\n\n  /* --- Form Styling --- */\n  .login-card {\n    width: 100%;\n    border: 1px solid var(--gold-dim);\n    background: rgba(10, 10, 10, 0.4);\n    backdrop-filter: blur(20px);\n    padding: 2.5rem 1.5rem;\n    display: flex;\n    flex-direction: column;\n    gap: 1.5rem;\n    opacity: 0;\n    transform: translateY(20px);\n  }\n\n  .field-group {\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n  }\n\n  .field-label {\n    font-size: 0.7rem;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    color: var(--gold);\n  }\n\n  .input-wrapper {\n    position: relative;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n    transition: border-color 0.3s ease;\n  }\n\n  .input-wrapper:focus-within {\n    border-color: var(--gold);\n  }\n\n  .login-input {\n    width: 100%;\n    background: transparent;\n    border: none;\n    outline: none;\n    color: var(--text-main);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 0.9rem;\n    padding: 0.75rem 0;\n    transition: transform 0.3s ease;\n  }\n\n  .login-input::placeholder {\n    color: rgba(255, 255, 255, 0.2);\n  }\n\n  .btn-submit {\n    margin-top: 1rem;\n    background: var(--gold);\n    color: var(--black);\n    border: none;\n    padding: 1rem;\n    font-family: 'Outfit', sans-serif;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .btn-submit:hover {\n    background: var(--gold-bright);\n    letter-spacing: 0.15em;\n  }\n\n  .btn-submit:active {\n    transform: scale(0.98);\n  }\n\n  .footer-links {\n    margin-top: 2rem;\n    font-size: 0.75rem;\n    color: var(--text-dim);\n    text-align: center;\n    opacity: 0;\n  }\n\n  /* --- Grain Texture Overlay --- */\n  .grain {\n    position: fixed;\n    inset: 0;\n    z-index: 5;\n    pointer-events: none;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3ExternalIcon%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    opacity: 0.04;\n    mix-blend-mode: overlay;\n  }\n</style>\n\n<div class=\"bg-container\" data-kid=\"1\">\n  <div class=\"bg-image\" data-kid=\"2\"></div>\n  <div class=\"bg-gradient\" data-kid=\"3\"></div>\n  <div class=\"light-sweep\" id=\"sweep\" data-kid=\"4\"></div>\n</div>\n\n<div class=\"grain\" data-kid=\"5\"></div>\n\n<div class=\"login-wrapper\" data-kid=\"6\">\n  <header class=\"brand-logo\" id=\"logo\" data-kid=\"7\">\n    <h1 data-kid=\"8\">Gallo Gold</h1>\n    <span data-kid=\"9\">BRUNO'S PREMIUM</span>\n  </header>\n\n  <main class=\"login-card\" id=\"card\" data-kid=\"10\">\n    <div class=\"field-group\" data-kid=\"11\">\n      <label class=\"field-label\" data-kid=\"12\">Usuario</label>\n      <div class=\"input-wrapper\" data-kid=\"13\">\n        <input type=\"text\" class=\"login-input\" placeholder=\"ID de acceso\" spellcheck=\"false\" data-kid=\"14\">\n      </div>\n    </div>\n\n    <div class=\"field-group\" data-kid=\"15\">\n      <label class=\"field-label\" data-kid=\"16\">Contraseña</label>\n      <div class=\"input-wrapper\" data-kid=\"17\">\n        <input type=\"password\" class=\"login-input\" placeholder=\"••••••••\" data-kid=\"18\">\n      </div>\n    </div>\n\n    <button class=\"btn-submit\" data-kid=\"19\">\n      Entrar al Sistema\n    </button>\n  </main>\n\n  <footer class=\"footer-links\" id=\"footer\" data-kid=\"20\">\n    Acceso restringido para personal autorizado\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"21\"></script>\n<script data-kid=\"22\">\n  window.addEventListener('load', () => {\n    const tl = gsap.timeline();\n\n    // Entrance Animation\n    tl.to('#logo', { opacity: 1, y: 0, duration: 1.2, ease: \"power4.out\" })\n      .to('#card', { opacity: 1, y: 0, duration: 1, ease: \"power3.out\" }, \"-=0.6\")\n      .to('#footer', { opacity: 1, duration: 1.5 }, \"-=0.4\");\n\n    // Infinite Light Sweep\n    gsap.set('#sweep', { xPercent: -100 });\n    \n    function startSweep() {\n      gsap.to('#sweep', {\n        xPercent: 100,\n        duration: 3,\n        ease: \"none\",\n        onComplete: () => {\n          gsap.set('#sweep', { xPercent: -100 });\n          gsap.delayedCall(7, startSweep); // Sweep every 10 seconds total\n        }\n      });\n    }\n\n    startSweep();\n    \n    // Subtle float on the logo\n    gsap.to('#logo', {\n      y: \"+=5\",\n      duration: 3,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n  });\n</script>",
