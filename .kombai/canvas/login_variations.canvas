      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800;900&display=swap');\n\n  :root {\n    --gold-primary: #C9A84C;\n    --gold-bright: #E8C97A;\n    --gold-dark: #A8862B;\n    --bg-black: #000000;\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Outfit', sans-serif;\n    background-color: var(--bg-black);\n    color: white;\n    min-height: 100vh;\n    overflow-x: clip;\n  }\n\n  /* --- Background --- */\n  .main-container {\n    min-height: 100vh;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n    padding: 2rem;\n    z-index: 10;\n  }\n\n  .bg-image {\n    position: fixed;\n    inset: 0;\n    background-image: url('/api/local/images/shared/login_background.png');\n    background-size: cover;\n    background-position: center;\n    opacity: 0.5;\n    z-index: 1;\n  }\n\n  .bg-overlay {\n    position: fixed;\n    inset: 0;\n    background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.85) 100%);\n    z-index: 2;\n  }\n\n  .diagonal-ray {\n    position: fixed;\n    top: -50%;\n    left: -50%;\n    width: 200%;\n    height: 200%;\n    background: linear-gradient(45deg, transparent 45%, rgba(201,168,76,0.08) 50%, transparent 55%);\n    transform: rotate(15deg);\n    pointer-events: none;\n    z-index: 3;\n  }\n\n  /* --- Glassmorphism Card --- */\n  .login-card {\n    width: 100%;\n    max-width: 420px;\n    padding: 3rem 2.5rem;\n    background: rgba(10, 10, 10, 0.45);\n    backdrop-filter: blur(30px);\n    -webkit-backdrop-filter: blur(30px);\n    border-radius: 40px;\n    position: relative;\n    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.8);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .glow-border::after {\n    content: '';\n    position: absolute;\n    inset: -1.5px;\n    background: linear-gradient(135deg, var(--gold-primary), transparent, var(--gold-dark), transparent, var(--gold-bright));\n    background-size: 300% 300%;\n    border-radius: 40px;\n    z-index: -1;\n    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n    mask-composite: exclude;\n    -webkit-mask-composite: destination-out;\n    opacity: 0.4;\n    animation: borderFlow 10s infinite linear;\n  }\n\n  @keyframes borderFlow {\n    0% { background-position: 0% 50%; }\n    50% { background-position: 100% 50%; }\n    100% { background-position: 0% 50%; }\n  }\n\n  /* --- Inputs --- */\n  .input-wrapper {\n    position: relative;\n    background: rgba(255, 255, 255, 0.03);\n    border: 1px solid rgba(255, 255, 255, 0.07);\n    border-radius: 16px;\n    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);\n  }\n\n  .input-wrapper:focus-within {\n    background: rgba(201, 168, 76, 0.04);\n    border-color: rgba(201, 168, 76, 0.5);\n    box-shadow: 0 0 20px rgba(201, 168, 76, 0.1);\n    transform: translateY(-1px);\n  }\n\n  .form-input {\n    width: 100%;\n    background: transparent;\n    border: none;\n    padding: 1.1rem 1.25rem;\n    color: white;\n    font-size: 1rem;\n    outline: none;\n  }\n\n  .form-input::placeholder {\n    color: rgba(255, 255, 255, 0.15);\n  }\n\n  /* --- Button --- */\n  .btn-gold {\n    width: 100%;\n    padding: 1.1rem;\n    background: linear-gradient(135deg, var(--gold-dark), var(--gold-primary), var(--gold-bright));\n    border: none;\n    border-radius: 16px;\n    color: #000;\n    font-weight: 800;\n    font-size: 0.95rem;\n    text-transform: uppercase;\n    letter-spacing: 0.15em;\n    cursor: pointer;\n    position: relative;\n    overflow: hidden;\n    box-shadow: 0 10px 30px -5px rgba(201, 168, 76, 0.35);\n  }\n\n  .btn-gold::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: rgba(255, 255, 255, 0);\n    transition: background 0.3s;\n  }\n\n  .btn-gold:hover::before {\n    background: rgba(255, 255, 255, 0.1);\n  }\n\n  .btn-gold::after {\n    content: '';\n    position: absolute;\n    top: -50%;\n    left: -150%;\n    width: 100%;\n    height: 200%;\n    background: linear-gradient(\n      to right,\n      rgba(255, 255, 255, 0) 0%,\n      rgba(255, 255, 255, 0.7) 50%,\n      rgba(255, 255, 255, 0) 100%\n    );\n    transform: rotate(30deg);\n    animation: shine 5s infinite ease-in-out;\n    pointer-events: none;\n  }\n\n  @keyframes shine {\n    0% { left: -150%; }\n    20% { left: 150%; }\n    100% { left: 150%; }\n  }\n\n  /* --- Brand Section --- */\n  .brand-logo {\n    filter: drop-shadow(0 0 35px rgba(201,168,76,0.5));\n    margin-bottom: 2rem;\n    width: 180px;\n    height: 180px;\n    position: relative;\n  }\n\n  /* Logo Backlight Glow */\n  .brand-logo::before {\n    content: '';\n    position: absolute;\n    inset: 20%;\n    background: radial-gradient(circle, rgba(201, 168, 76, 0.4) 0%, transparent 70%);\n    filter: blur(40px);\n    z-index: -1;\n  }\n\n  .brand-name {\n    font-size: clamp(3rem, 6vw, 4.5rem);\n    font-weight: 900;\n    background: linear-gradient(to bottom, #FFFFFF 20%, #F9E4B7 50%, var(--gold-primary) 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    letter-spacing: -0.05em;\n    line-height: 0.85;\n    margin: 0;\n    text-transform: uppercase;\n    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));\n  }\n\n  .brand-tagline {\n    font-size: 0.75rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.6em;\n    color: var(--gold-primary);\n    margin-top: 0.75rem;\n    opacity: 0.9;\n  }\n\n  /* --- Utils --- */\n  .label-text {\n    font-size: 0.7rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.2em;\n    color: var(--gold-primary);\n    display: block;\n    margin-bottom: 0.6rem;\n    margin-left: 0.5rem;\n  }\n</style>\n\n<div class=\"bg-image\" data-kid=\"1\"></div>\n<div class=\"bg-overlay\" data-kid=\"2\"></div>\n<div class=\"diagonal-ray\" id=\"ray\" data-kid=\"3\"></div>\n\n<main class=\"main-container\" data-kid=\"4\">\n  <div class=\"flex flex-col items-center w-full relative\" data-kid=\"5\">\n    \n    \n    <div class=\"flex flex-col items-center mb-12 text-center\" id=\"logo-section\" data-kid=\"6\">\n      <div class=\"brand-logo\" id=\"rooster-container\" data-kid=\"7\">\n        <svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full h-full\" data-kid=\"8\">\n          <defs data-kid=\"9\">\n            <linearGradient id=\"rooster-grad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\" data-kid=\"10\">\n              <stop offset=\"0%\" stop-color=\"#F9E4B7\" data-kid=\"11\"></stop>\n              <stop offset=\"40%\" stop-color=\"#C9A84C\" data-kid=\"12\"></stop>\n              <stop offset=\"100%\" stop-color=\"#846519\" data-kid=\"13\"></stop>\n            </linearGradient>\n            <filter id=\"fire-glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\" data-kid=\"14\">\n              <feGaussianBlur stdDeviation=\"3\" result=\"blur\" data-kid=\"15\"></feGaussianBlur>\n              <feFlood flood-color=\"#FF3B3B\" flood-opacity=\"0.5\" result=\"flood\" data-kid=\"16\"></feFlood>\n              <feComposite in=\"flood\" in2=\"blur\" operator=\"in\" result=\"glow\" data-kid=\"17\"></feComposite>\n              <feMerge data-kid=\"18\">\n                <feMergeNode in=\"glow\" data-kid=\"19\"></feMergeNode>\n                <feMergeNode in=\"SourceGraphic\" data-kid=\"20\"></feMergeNode>\n              </feMerge>\n            </filter>\n          </defs>\n          \n          \n          <g id=\"tail-feathers\" data-kid=\"21\">\n            <path d=\"M70,140 C40,180 20,160 30,120\" stroke=\"url(#rooster-grad)\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\" data-kid=\"22\"></path>\n            <path d=\"M80,145 C60,190 40,180 50,130\" stroke=\"url(#rooster-grad)\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\" data-kid=\"23\"></path>\n            <path d=\"M130,140 C160,180 180,160 170,120\" stroke=\"url(#rooster-grad)\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\" data-kid=\"24\"></path>\n            <path d=\"M120,145 C140,190 160,180 150,130\" stroke=\"url(#rooster-grad)\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\" data-kid=\"25\"></path>\n          </g>\n\n          \n          <path id=\"wing-left\" d=\"M90,90 C40,40 -10,80 20,130 C40,140 70,130 90,90\" fill=\"url(#rooster-grad)\" opacity=\"0.95\" data-kid=\"26\"></path>\n          <path id=\"wing-right\" d=\"M110,90 C160,40 210,80 180,130 C160,140 130,130 110,90\" fill=\"url(#rooster-grad)\" opacity=\"0.95\" data-kid=\"27\"></path>\n\n          \n          <path d=\"M100,50 C125,60 135,100 120,145 C110,165 90,165 80,145 C65,100 75,60 100,50 Z\" fill=\"url(#rooster-grad)\" data-kid=\"28\"></path>\n          \n          \n          <path d=\"M100,50 C105,35 100,20 90,22 C80,24 75,40 80,55\" fill=\"url(#rooster-grad)\" data-kid=\"29\"></path>\n          \n          \n          <path d=\"M90,22 C95,2 105,5 105,15 M90,22 C85,2 75,5 75,15 M90,22 C90,5 95,2 100,10\" fill=\"#EF4444\" filter=\"url(#fire-glow)\" data-kid=\"30\"></path>\n          \n          \n          <path d=\"M82,34 L74,38 L82,42 Z\" fill=\"#F59E0B\" data-kid=\"31\"></path>\n          <path d=\"M85,42 C85,50 90,52 90,46\" fill=\"#EF4444\" data-kid=\"32\"></path>\n          \n          \n          <path d=\"M90,155 L85,180 M110,155 L115,180\" stroke=\"#C9A84C\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"33\"></path>\n        </svg>\n      </div>\n      <h1 class=\"brand-name\" data-kid=\"34\">GALLO GOLD</h1>\n      <p class=\"brand-tagline\" data-kid=\"35\">Elite Experience</p>\n    </div>\n\n    \n    <div class=\"login-card glow-border\" id=\"login-card\" data-kid=\"36\">\n      <form class=\"flex flex-col gap-7\" onsubmit=\"return false\" data-kid=\"37\">\n        \n        <div class=\"group\" data-kid=\"38\">\n          <label class=\"label-text\" data-kid=\"39\">User ID</label>\n          <div class=\"input-wrapper\" data-kid=\"40\">\n            <input type=\"text\" class=\"form-input\" placeholder=\"Enter your username\" data-kid=\"41\">\n          </div>\n        </div>\n\n        <div class=\"group\" data-kid=\"42\">\n          <label class=\"label-text\" data-kid=\"43\">Password</label>\n          <div class=\"input-wrapper flex items-center\" data-kid=\"44\">\n            <input type=\"password\" id=\"pass\" class=\"form-input\" placeholder=\"••••••••\" data-kid=\"45\">\n            <button type=\"button\" class=\"px-4 text-white/30 hover:text-[var(--gold-primary)] transition-colors\" onclick=\"togglePass()\" data-kid=\"46\">\n              <svg id=\"eye-icon\" xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"47\"><path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z\" data-kid=\"48\"></path><circle cx=\"12\" cy=\"12\" r=\"3\" data-kid=\"49\"></circle></svg>\n            </button>\n          </div>\n        </div>\n\n        <div class=\"flex items-center justify-between mt-[-0.5rem] px-1\" data-kid=\"50\">\n          <label class=\"flex items-center gap-2 cursor-pointer group/check\" data-kid=\"51\">\n            <div class=\"w-4 h-4 rounded border border-white/30 flex items-center justify-center group-hover/check:border-[var(--gold-primary)] transition-colors\" data-kid=\"52\">\n              <input type=\"checkbox\" class=\"hidden peer\" data-kid=\"53\">\n              <div class=\"w-2.5 h-2.5 bg-[var(--gold-primary)] rounded-xs opacity-0 peer-checked:opacity-100 transition-opacity\" data-kid=\"54\"></div>\n            </div>\n            <span class=\"text-xs text-white/70 group-hover/check:text-white transition-colors\" data-kid=\"55\">Remember me</span>\n          </label>\n          <a href=\"#\" class=\"text-xs text-[var(--gold-primary)] font-bold hover:text-[var(--gold-bright)] transition-colors\" data-kid=\"56\">Forgot Access?</a>\n        </div>\n\n        <button type=\"submit\" class=\"btn-gold\" data-kid=\"57\">\n          Secure Login\n        </button>\n\n        <div class=\"text-center\" data-kid=\"58\">\n          <span class=\"text-xs text-white/40\" data-kid=\"59\">Don't have an account?</span>\n          <a href=\"#\" class=\"text-xs text-[var(--gold-primary)] font-bold ml-1 hover:underline\" data-kid=\"60\">Request Invite</a>\n        </div>\n\n      </form>\n    </div>\n\n    \n    <div class=\"mt-12 text-center opacity-0\" id=\"extra-info\" data-kid=\"61\">\n      <p class=\"text-[10px] tracking-[0.4em] text-white/20 uppercase\" data-kid=\"62\">Encrypted • Secure • Private</p>\n    </div>\n\n  </div>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"63\"></script>\n<script data-kid=\"64\">\n  function togglePass() {\n    const input = document.getElementById('pass');\n    input.type = input.type === 'password' ? 'text' : 'password';\n  }\n\n  window.addEventListener('DOMContentLoaded', () => {\n    const tl = gsap.timeline({ defaults: { ease: \"power4.out\" } });\n\n    // Initial states\n    gsap.set(\"#logo-section\", { y: -80, opacity: 0 });\n    gsap.set(\"#login-card\", { y: 80, opacity: 0, scale: 0.9 });\n    gsap.set(\"#ray\", { opacity: 0 });\n    \n    // Animation Sequence\n    tl.to(\"#ray\", { opacity: 1, duration: 2 })\n      .to(\"#logo-section\", { y: 0, opacity: 1, duration: 1.8, ease: \"expo.out\" }, \"-=1.6\")\n      .to(\"#login-card\", { y: 0, opacity: 1, scale: 1, duration: 1.4, ease: \"expo.out\" }, \"-=1.4\")\n      .to(\"#extra-info\", { opacity: 1, duration: 1 }, \"-=0.8\");\n\n    // Majestic Wing Flapping / Unfolding - More dramatic\n    gsap.from(\"#wing-left\", {\n      rotation: -50,\n      scale: 0.8,\n      transformOrigin: \"100% 50%\",\n      duration: 2.5,\n      ease: \"elastic.out(1, 0.5)\",\n      delay: 0.8\n    });\n\n    gsap.from(\"#wing-right\", {\n      rotation: 50,\n      scale: 0.8,\n      transformOrigin: \"0% 50%\",\n      duration: 2.5,\n      ease: \"elastic.out(1, 0.5)\",\n      delay: 0.8\n    });\n\n    // Subtle Continuous Wing Motion\n    const flapTl = gsap.timeline({ repeat: -1, yoyo: true });\n    flapTl.to(\"#wing-left\", { rotation: -3, transformOrigin: \"right center\", duration: 3, ease: \"sine.inOut\" })\n          .to(\"#wing-right\", { rotation: 3, transformOrigin: \"left center\", duration: 3, ease: \"sine.inOut\" }, 0);\n\n    // Floating Effect for Logo\n    gsap.to(\"#rooster-container\", {\n      y: -12,\n      duration: 4,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n\n    // Diagonal Ray Movement\n    gsap.to(\"#ray\", {\n      x: 80,\n      y: 80,\n      duration: 20,\n      repeat: -1,\n      yoyo: true,\n      ease: \"linear\"\n    });\n  });\n</script>\n",
