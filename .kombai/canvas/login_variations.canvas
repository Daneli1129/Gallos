      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Inter:wght@300;400;500;600&display=swap');\n\n    :root {\n        --gold: #C9A84C;\n        --gold-bright: #E8C97A;\n        --gold-dark: #A8862B;\n        --bg-black: #000000;\n        --surface-1: #0a0a0a;\n        --surface-2: #141414;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: var(--bg-black);\n        color: white;\n        font-family: 'Inter', sans-serif;\n        overflow-x: clip;\n    }\n\n    .font-cinzel { font-family: 'Cinzel', serif; }\n    .font-inter { font-family: 'Inter', sans-serif; }\n\n    /* Glassmorphism Classes */\n    .glass-card {\n        background: rgba(10, 10, 10, 0.6);\n        backdrop-filter: blur(40px);\n        -webkit-backdrop-filter: blur(40px);\n        border: 1px solid rgba(201, 168, 76, 0.12);\n        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.95);\n    }\n\n    .gold-input {\n        background: rgba(255, 255, 255, 0.02);\n        border: 1px solid rgba(255, 255, 255, 0.08);\n        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n\n    .gold-input:focus {\n        border-color: var(--gold);\n        background: rgba(201, 168, 76, 0.05);\n        box-shadow: 0 0 15px rgba(201, 168, 76, 0.1);\n        outline: none;\n    }\n\n    .gold-button {\n        background: linear-gradient(135deg, var(--gold-dark) 0%, var(--gold) 50%, var(--gold-bright) 100%);\n        position: relative;\n        overflow: hidden;\n        transition: transform 0.3s ease, box-shadow 0.3s ease;\n    }\n\n    .gold-button::after {\n        content: '';\n        position: absolute;\n        top: -50%;\n        left: -50%;\n        width: 200%;\n        height: 200%;\n        background: linear-gradient(45deg, transparent, rgba(255,255,255,0.3), transparent);\n        transform: rotate(45deg);\n        transition: 0.5s;\n        left: -150%;\n    }\n\n    .gold-button:hover::after {\n        left: 150%;\n    }\n\n    /* Aura Pulse */\n    .aura-glow {\n        background: radial-gradient(circle, rgba(201, 168, 76, 0.2) 0%, rgba(0, 0, 0, 0) 70%);\n        filter: blur(40px);\n    }\n\n    /* Scrollbar */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: var(--bg-black); }\n    ::-webkit-scrollbar-thumb { background: var(--gold-dark); border-radius: 10px; }\n\n    /* Layout Specifics */\n    @media (min-width: 1024px) {\n        .split-height { height: 100vh; }\n    }\n</style>\n\n<div class=\"flex flex-col lg:flex-row min-h-screen w-full bg-black overflow-x-clip\" data-kid=\"1\">\n    \n    \n    <div class=\"relative w-full lg:w-1/2 split-height flex items-center justify-center bg-[#020202] order-2 lg:order-1\" data-kid=\"2\">\n        \n        <div id=\"main-aura\" class=\"aura-glow absolute w-[140%] h-[140%] opacity-60\" data-kid=\"3\"></div>\n        <div id=\"secondary-aura\" class=\"aura-glow absolute w-[100%] h-[100%] opacity-30 scale-75\" data-kid=\"4\"></div>\n        <div id=\"core-aura\" class=\"aura-glow absolute w-[60%] h-[60%] opacity-40 mix-blend-screen\" data-kid=\"5\"></div>\n\n        \n        <div id=\"rooster-wrapper\" class=\"relative z-10 w-4/5 max-w-2xl aspect-square flex items-center justify-center\" data-kid=\"6\">\n            <svg viewBox=\"0 0 400 400\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full h-full drop-shadow-[0_0_50px_rgba(201,168,76,0.4)]\" data-kid=\"7\">\n                <defs data-kid=\"8\">\n                    <linearGradient id=\"gold-fill\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\" data-kid=\"9\">\n                        <stop offset=\"0%\" stop-color=\"#A8862B\" data-kid=\"10\"></stop>\n                        <stop offset=\"50%\" stop-color=\"#C9A84C\" data-kid=\"11\"></stop>\n                        <stop offset=\"100%\" stop-color=\"#E8C97A\" data-kid=\"12\"></stop>\n                    </linearGradient>\n                    <filter id=\"gold-glow\" data-kid=\"13\">\n                        <feGaussianBlur stdDeviation=\"3\" result=\"blur\" data-kid=\"14\"></feGaussianBlur>\n                        <feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\" data-kid=\"15\"></feComposite>\n                    </filter>\n                </defs>\n\n                \n                <g id=\"l-wing\" class=\"origin-[200px_220px]\" data-kid=\"16\">\n                    <path d=\"M180,220 L140,160 L100,140 L40,160 L10,240 L60,260 L120,240 Z\" fill=\"url(#gold-fill)\" opacity=\"0.9\" data-kid=\"17\"></path>\n                    <path d=\"M175,235 L130,180 L80,170 L20,200 L0,270 L50,290 L110,260 Z\" fill=\"url(#gold-fill)\" opacity=\"0.7\" data-kid=\"18\"></path>\n                    <path d=\"M170,250 L120,200 L60,200 L0,240 L-20,310 L40,330 L100,280 Z\" fill=\"url(#gold-fill)\" opacity=\"0.5\" data-kid=\"19\"></path>\n                    \n                    <path d=\"M30,200 L10,240\" stroke=\"#E8C97A\" stroke-width=\"1\" opacity=\"0.4\" data-kid=\"20\"></path>\n                    <path d=\"M50,220 L30,260\" stroke=\"#E8C97A\" stroke-width=\"1\" opacity=\"0.4\" data-kid=\"21\"></path>\n                </g>\n\n                <g id=\"r-wing\" class=\"origin-[200px_220px]\" data-kid=\"22\">\n                    <path d=\"M220,220 L260,160 L300,140 L360,160 L390,240 L340,260 L280,240 Z\" fill=\"url(#gold-fill)\" opacity=\"0.9\" data-kid=\"23\"></path>\n                    <path d=\"M225,235 L270,180 L320,170 L380,200 L400,270 L350,290 L290,260 Z\" fill=\"url(#gold-fill)\" opacity=\"0.7\" data-kid=\"24\"></path>\n                    <path d=\"M230,250 L280,200 L340,200 L400,240 L420,310 L360,330 L300,280 Z\" fill=\"url(#gold-fill)\" opacity=\"0.5\" data-kid=\"25\"></path>\n                    \n                    <path d=\"M370,200 L390,240\" stroke=\"#E8C97A\" stroke-width=\"1\" opacity=\"0.4\" data-kid=\"26\"></path>\n                    <path d=\"M350,220 L370,260\" stroke=\"#E8C97A\" stroke-width=\"1\" opacity=\"0.4\" data-kid=\"27\"></path>\n                </g>\n\n                \n                <path id=\"rooster-body\" d=\"M200,140 L230,170 L245,240 L220,340 L200,370 L180,340 L155,240 L170,170 Z\" fill=\"url(#gold-fill)\" filter=\"url(#gold-glow)\" data-kid=\"28\"></path>\n                \n                \n                <g id=\"rooster-head\" data-kid=\"29\">\n                    <path d=\"M190,145 L180,80 L205,60 L235,90 L220,135 Z\" fill=\"url(#gold-fill)\" data-kid=\"30\"></path>\n                    \n                    <path d=\"M185,75 Q170,40 200,50 Q215,30 230,60 Q250,45 250,85\" fill=\"#C0392B\" data-kid=\"31\"></path>\n                    \n                    <path d=\"M195,55 L195,35 M210,48 L210,28 M225,55 L225,35\" stroke=\"#E8C97A\" stroke-width=\"2\" data-kid=\"32\"></path>\n                    \n                    <path d=\"M235,95 L260,105 L235,115 Z\" fill=\"#E8C97A\" data-kid=\"33\"></path>\n                    \n                    <circle cx=\"212\" cy=\"90\" r=\"3\" fill=\"black\" data-kid=\"34\"></circle>\n                </g>\n\n                \n                <g id=\"tail\" data-kid=\"35\">\n                    <path d=\"M170,340 Q100,380 140,280\" stroke=\"url(#gold-fill)\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"36\"></path>\n                    <path d=\"M200,360 Q200,400 230,300\" stroke=\"url(#gold-fill)\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"37\"></path>\n                    <path d=\"M230,340 Q300,380 260,280\" stroke=\"url(#gold-fill)\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"38\"></path>\n                </g>\n            </svg>\n        </div>\n\n        \n        <div class=\"absolute inset-0 pointer-events-none opacity-20\" data-kid=\"39\">\n            <div class=\"absolute top-1/4 left-1/4 w-1 h-1 bg-gold rounded-full blur-xs animate-pulse\" data-kid=\"40\"></div>\n            <div class=\"absolute bottom-1/3 right-1/4 w-1.5 h-1.5 bg-gold rounded-full blur-xs animate-pulse delay-700\" data-kid=\"41\"></div>\n            <div class=\"absolute top-1/2 right-1/3 w-1 h-1 bg-white rounded-full blur-xs animate-pulse delay-1000\" data-kid=\"42\"></div>\n        </div>\n    </div>\n\n    \n    <div class=\"relative w-full lg:w-1/2 split-height flex items-center justify-center p-6 lg:p-12 z-20 order-1 lg:order-2 bg-black\" data-kid=\"43\">\n        <div id=\"login-container\" class=\"glass-card w-full max-w-lg rounded-[2.5rem] p-8 md:p-16 flex flex-col items-center space-y-10 border border-white/5\" data-kid=\"44\">\n            \n            \n            <div class=\"text-center space-y-3\" data-kid=\"45\">\n                <div id=\"logo-gold\" class=\"flex justify-center mb-2\" data-kid=\"46\">\n                    <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-[var(--gold)]\" data-kid=\"47\"><path d=\"m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7Z\" data-kid=\"48\"></path><path d=\"M12 17v4\" data-kid=\"49\"></path><path d=\"m9 21 3-2 3 2\" data-kid=\"50\"></path></svg>\n                </div>\n                <h2 id=\"title-text\" class=\"text-5xl font-cinzel font-black tracking-[0.3em] text-[var(--gold)] leading-none\" data-kid=\"51\">BRUNO'S</h2>\n                <div class=\"h-0.5 w-16 bg-[var(--gold)] mx-auto opacity-50 rounded-full\" data-kid=\"52\"></div>\n                <p id=\"subtitle-text\" class=\"text-[var(--gold-bright)]/40 font-inter text-xs uppercase tracking-[0.4em] font-medium pt-2\" data-kid=\"53\">Royal Betting Experience</p>\n            </div>\n\n            \n            <form id=\"login-form\" class=\"w-full space-y-8\" data-kid=\"54\">\n                <div class=\"form-group space-y-3\" data-kid=\"55\">\n                    <label class=\"text-white/70 text-xs font-inter uppercase tracking-[0.3em] ml-2 font-black\" data-kid=\"56\">Member Access ID</label>\n                    <div class=\"relative group\" data-kid=\"57\">\n                        <input type=\"text\" class=\"gold-input w-full px-6 py-5 rounded-2xl text-white font-inter placeholder:text-white/30 focus:bg-white/5\" placeholder=\"Username or Email\" data-kid=\"58\">\n                        <div class=\"absolute right-6 top-1/2 -translate-y-1/2 text-white/40 group-focus-within:text-[var(--gold)] transition-colors\" data-kid=\"59\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"60\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\" data-kid=\"61\"></path><circle cx=\"12\" cy=\"7\" r=\"4\" data-kid=\"62\"></circle></svg>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"form-group space-y-3\" data-kid=\"63\">\n                    <div class=\"flex justify-between items-center px-2\" data-kid=\"64\">\n                        <label class=\"text-white/70 text-xs font-inter uppercase tracking-[0.3em] font-black\" data-kid=\"65\">Secure Password</label>\n                        <a href=\"#\" class=\"text-[var(--gold)] text-xs uppercase tracking-widest hover:text-[var(--gold-bright)] transition-colors font-bold\" data-kid=\"66\">Forgot?</a>\n                    </div>\n                    <div class=\"relative group\" data-kid=\"67\">\n                        <input type=\"password\" class=\"gold-input w-full px-6 py-5 rounded-2xl text-white font-inter placeholder:text-white/30 focus:bg-white/5\" placeholder=\"••••••••••••\" data-kid=\"68\">\n                        <div class=\"absolute right-6 top-1/2 -translate-y-1/2 text-white/40 group-focus-within:text-[var(--gold)] transition-colors\" data-kid=\"69\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"70\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\" data-kid=\"71\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\" data-kid=\"72\"></path></svg>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"form-group pt-4\" data-kid=\"73\">\n                    <button type=\"submit\" class=\"gold-button w-full py-6 rounded-2xl text-black font-black font-inter text-sm tracking-[0.2em] shadow-xl hover:shadow-[var(--gold)/30] transform active:scale-95 cursor-pointer\" data-kid=\"74\">\n                        ENTER THE ROYALTY\n                    </button>\n                </div>\n            </form>\n\n            \n            <div id=\"form-footer\" class=\"w-full flex flex-col items-center space-y-6 pt-2\" data-kid=\"75\">\n                <div class=\"flex items-center space-x-4 w-full\" data-kid=\"76\">\n                    <div class=\"h-px grow bg-white/10\" data-kid=\"77\"></div>\n                    <span class=\"text-white/30 text-xs uppercase tracking-widest font-inter font-bold\" data-kid=\"78\">OR JOIN US</span>\n                    <div class=\"h-px grow bg-white/10\" data-kid=\"79\"></div>\n                </div>\n                \n                <p class=\"text-white/60 text-sm font-inter tracking-wide\" data-kid=\"80\">\n                    New to the court? \n                    <a href=\"#\" class=\"text-[var(--gold)] font-bold hover:text-[var(--gold-bright)] transition-colors ml-1 underline underline-offset-4 decoration-white/20\" data-kid=\"81\">Create an Account</a>\n                </p>\n\n                \n                <div class=\"flex items-center space-x-3 text-white/20 border border-white/5 px-4 py-2 rounded-full\" data-kid=\"82\">\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" data-kid=\"83\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\" data-kid=\"84\"></path></svg>\n                    <span class=\"text-[10px] uppercase tracking-[0.2em] font-bold\" data-kid=\"85\">Encrypted Royal Server</span>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"86\"></script>\n<script data-kid=\"87\">\n    document.addEventListener(\"DOMContentLoaded\", () => {\n        // Init GSAP\n        const tl = gsap.timeline();\n\n        // Entry Animations\n        tl.from(\"#rooster-wrapper\", {\n            scale: 0.8,\n            opacity: 0,\n            duration: 1.5,\n            ease: \"power3.out\"\n        })\n        .from(\"#login-container\", {\n            x: 50,\n            opacity: 0,\n            duration: 1.2,\n            ease: \"power4.out\"\n        }, \"-=1\")\n        .from(\".form-group\", {\n            y: 20,\n            opacity: 0,\n            stagger: 0.1,\n            duration: 0.8,\n            ease: \"back.out(1.7)\"\n        }, \"-=0.5\")\n        .from(\"#logo-gold, #title-text, #subtitle-text\", {\n            y: -20,\n            opacity: 0,\n            stagger: 0.1,\n            duration: 0.8,\n            ease: \"power2.out\"\n        }, \"-=1.2\");\n\n        // Continuous Rooster Animations\n        // Breathing Body\n        gsap.to(\"#rooster-body\", {\n            scale: 1.08,\n            transformOrigin: \"center center\",\n            duration: 3,\n            repeat: -1,\n            yoyo: true,\n            ease: \"sine.inOut\"\n        });\n\n        // Flapping Wings\n        gsap.to(\"#l-wing\", {\n            rotate: -2,\n            duration: 2.5,\n            repeat: -1,\n            yoyo: true,\n            ease: \"power1.inOut\"\n        });\n        gsap.to(\"#r-wing\", {\n            rotate: 2,\n            duration: 2.5,\n            repeat: -1,\n            yoyo: true,\n            ease: \"power1.inOut\"\n        });\n\n        // Tail movement\n        gsap.to(\"#tail\", {\n            y: -5,\n            duration: 1.8,\n            repeat: -1,\n            yoyo: true,\n            ease: \"sine.inOut\"\n        });\n\n        // Background Aura Pulse\n        gsap.to(\"#main-aura\", {\n            scale: 1.2,\n            opacity: 0.8,\n            duration: 5,\n            repeat: -1,\n            yoyo: true,\n            ease: \"sine.inOut\"\n        });\n        gsap.to(\"#secondary-aura\", {\n            scale: 0.9,\n            opacity: 0.5,\n            duration: 4,\n            repeat: -1,\n            yoyo: true,\n            ease: \"sine.inOut\",\n            delay: 1\n        });\n        gsap.to(\"#core-aura\", {\n            scale: 1.4,\n            opacity: 0.6,\n            duration: 3,\n            repeat: -1,\n            yoyo: true,\n            ease: \"power1.inOut\"\n        });\n        \n        // Slight float for the whole rooster\n        gsap.to(\"#rooster-wrapper\", {\n            y: -15,\n            duration: 4,\n            repeat: -1,\n            yoyo: true,\n            ease: \"power1.inOut\"\n        });\n    });\n</script>\n",
