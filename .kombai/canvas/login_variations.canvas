      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Outfit:wght@300;400;600&display=swap');\n\n  :root {\n    --gold: #D4AF37;\n    --gold-light: #F3E2B3;\n    --gold-dark: #926F34;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    font-family: 'Outfit', sans-serif;\n    color: white;\n    background-color: #0a0a0a;\n  }\n\n  .gold-gradient-text {\n    background: linear-gradient(to bottom, #F3E2B3 0%, #D4AF37 50%, #B8860B 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .portal-shadow {\n    box-shadow: \n      0 0 80px 5px rgba(212, 175, 55, 0.1),\n      0 40px 100px -20px rgba(212, 175, 55, 0.2);\n  }\n\n  /* Remove default ring on focus */\n  input:focus {\n    outline: none;\n  }\n</style>\n\n<div class=\"relative min-h-screen w-full flex items-center justify-center overflow-x-clip\" data-kid=\"1\">\n  \n  <div class=\"absolute inset-0 z-0\" data-kid=\"2\">\n    <img src=\"/api/local/images/shared/login_background.png\" alt=\"Background\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"3\">\n  </div>\n\n  \n  <div class=\"relative z-10 w-full max-w-lg px-6 flex flex-col items-center\" data-kid=\"4\">\n    \n    \n    <div class=\"mb-10 flex flex-col items-center\" data-kid=\"5\">\n      <div id=\"rooster-portal\" class=\"w-32 h-32 mb-4 relative flex items-center justify-center\" data-kid=\"6\">\n        \n        <svg id=\"rooster-svg\" viewBox=\"0 0 100 100\" class=\"w-full h-full drop-shadow-[0_0_35px_rgba(212,175,55,0.4)]\" data-kid=\"7\">\n          \n          <path d=\"M50 35 L50 85\" stroke=\"var(--gold)\" stroke-width=\"3\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"8\"></path>\n          \n          <path id=\"left-wing\" d=\"M48 45 C25 40 5 50 5 75 Q20 85 48 70\" fill=\"var(--gold)\" style=\"transform-origin: 48px 45px;\" data-kid=\"9\"></path>\n          \n          <path id=\"right-wing\" d=\"M52 45 C75 40 95 50 95 75 Q80 85 52 70\" fill=\"var(--gold)\" style=\"transform-origin: 52px 45px;\" data-kid=\"10\"></path>\n          \n          <path d=\"M50 35 Q40 15 65 25 Q55 35 50 35\" fill=\"#EF4444\" data-kid=\"11\"></path>\n          <circle cx=\"50\" cy=\"35\" r=\"6\" fill=\"var(--gold-light)\" data-kid=\"12\"></circle>\n        </svg>\n      </div>\n      <h1 class=\"text-6xl md:text-7xl font-black font-['Playfair_Display'] gold-gradient-text tracking-[-0.05em] text-center drop-shadow-[0_15px_15px_rgba(0,0,0,0.6)]\" data-kid=\"13\">Gallo Gold</h1>\n    </div>\n\n    \n    <div id=\"login-portal\" class=\"w-full bg-black/30 backdrop-blur-3xl rounded-[3rem] p-10 md:p-14 portal-shadow relative overflow-hidden group\" data-kid=\"14\">\n      \n      \n      <div class=\"relative z-10 flex flex-col items-center\" data-kid=\"15\">\n        <h2 class=\"text-white/70 text-[10px] uppercase tracking-[0.6em] font-bold mb-10\" data-kid=\"16\">Access Portal</h2>\n        \n        <form class=\"w-full space-y-8\" data-kid=\"17\">\n          \n          <div class=\"relative group/input\" data-kid=\"18\">\n            <input type=\"text\" id=\"username\" placeholder=\" \" class=\"peer w-full bg-transparent border-b border-white/20 py-4 text-white text-lg placeholder-transparent transition-all focus:border-[var(--gold)]\" data-kid=\"19\">\n            <label for=\"username\" class=\"absolute left-0 top-4 text-white/40 text-[10px] tracking-[0.2em] font-medium transition-all pointer-events-none peer-focus:-top-4 peer-focus:text-[var(--gold)] peer-[:not(:placeholder-shown)]:-top-4\" data-kid=\"20\">ACCESS KEY</label>\n            <div class=\"absolute bottom-0 left-0 w-0 h-[1.5px] bg-[var(--gold)] transition-all duration-700 peer-focus:w-full\" data-kid=\"21\"></div>\n          </div>\n\n          \n          <div class=\"relative group/input\" data-kid=\"22\">\n            <input type=\"password\" id=\"password\" placeholder=\" \" class=\"peer w-full bg-transparent border-b border-white/20 py-4 text-white text-lg placeholder-transparent transition-all focus:border-[var(--gold)]\" data-kid=\"23\">\n            <label for=\"password\" class=\"absolute left-0 top-4 text-white/40 text-[10px] tracking-[0.2em] font-medium transition-all pointer-events-none peer-focus:-top-4 peer-focus:text-[var(--gold)] peer-[:not(:placeholder-shown)]:-top-4\" data-kid=\"24\">ENCRYPTION PIN</label>\n            <div class=\"absolute bottom-0 left-0 w-0 h-[1.5px] bg-[var(--gold)] transition-all duration-700 peer-focus:w-full\" data-kid=\"25\"></div>\n          </div>\n\n          \n          <button type=\"submit\" class=\"w-full group/btn relative overflow-hidden py-5 rounded-2xl bg-[var(--gold)] text-black font-bold uppercase tracking-[0.4em] text-xs transition-all hover:bg-[var(--gold-light)] hover:scale-[1.01] active:scale-95 shadow-[0_15px_30px_-10px_rgba(212,175,55,0.6)]\" data-kid=\"26\">\n            <span class=\"relative z-10\" data-kid=\"27\">Enter Vault</span>\n            <div class=\"absolute inset-0 bg-white/20 translate-x-[-100%] group-hover/btn:translate-x-[100%] transition-transform duration-700 ease-in-out\" data-kid=\"28\"></div>\n          </button>\n        </form>\n\n        <div class=\"mt-12 flex flex-col md:flex-row justify-between items-center w-full gap-4 text-[9px] uppercase tracking-[0.3em] text-white/30 font-semibold\" data-kid=\"29\">\n          <a href=\"#\" class=\"hover:text-[var(--gold)] transition-colors duration-300\" data-kid=\"30\">Lost Credentials?</a>\n          <span class=\"hidden md:block w-1 h-1 bg-white/10 rounded-full\" data-kid=\"31\"></span>\n          <a href=\"#\" class=\"hover:text-[var(--gold)] transition-colors duration-300\" data-kid=\"32\">Request Membership</a>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"mt-12 opacity-20 flex gap-2\" data-kid=\"33\">\n      <div class=\"w-2 h-2 rounded-full bg-[var(--gold)]\" data-kid=\"34\"></div>\n      <div class=\"w-2 h-2 rounded-full bg-[var(--gold)]\" data-kid=\"35\"></div>\n      <div class=\"w-2 h-2 rounded-full bg-[var(--gold)]\" data-kid=\"36\"></div>\n    </div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"37\"></script>\n<script data-kid=\"38\">\n  window.addEventListener('load', () => {\n    const tl = gsap.timeline({defaults: {ease: \"power3.out\"}});\n\n    // Initial State (GSAP will handle the \"from\")\n    \n    tl.from(\"#rooster-portal\", {\n      scale: 0.2,\n      opacity: 0,\n      duration: 1.2,\n      ease: \"power4.out\"\n    })\n    .from(\"#left-wing\", {\n      rotation: -110,\n      opacity: 0,\n      duration: 1.8,\n      ease: \"expo.out\"\n    }, \"-=0.8\")\n    .from(\"#right-wing\", {\n      rotation: 110,\n      opacity: 0,\n      duration: 1.8,\n      ease: \"expo.out\"\n    }, \"-=1.8\")\n    .from(\".gold-gradient-text\", {\n      y: 30,\n      opacity: 0,\n      duration: 1.2,\n      filter: \"blur(10px)\"\n    }, \"-=1\")\n    .from(\"#login-portal\", {\n      y: 100,\n      opacity: 0,\n      duration: 1.5,\n      scale: 0.9,\n      ease: \"power4.out\"\n    }, \"-=1.2\")\n    .from(\"form > div\", {\n      y: 10,\n      opacity: 0,\n      stagger: 0.2,\n      duration: 0.8\n    }, \"-=0.5\");\n\n    // Idle wing animation\n    gsap.to([\"#left-wing\", \"#right-wing\"], {\n      scaleY: 1.05,\n      duration: 2,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n  });\n</script>\n",
