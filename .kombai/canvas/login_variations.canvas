      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800;900&display=swap');\n\n  .font-outfit {\n    font-family: 'Outfit', sans-serif;\n  }\n\n  body {\n    background-color: #000000;\n    margin: 0;\n    padding: 0;\n    height: 100vh;\n    overflow: hidden;\n  }\n\n  /* Decorative gold gradients in corners */\n  .bg-glow-tl {\n    background: radial-gradient(circle at top left, rgba(201, 168, 76, 0.15), transparent 60%);\n  }\n  .bg-glow-br {\n    background: radial-gradient(circle at bottom right, rgba(168, 134, 43, 0.1), transparent 60%);\n  }\n\n  /* Embers container */\n  #embers-container {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  /* Rooster Beat Animation */\n  .rooster-glow {\n    filter: drop-shadow(0 0 8px rgba(201, 168, 76, 0.4));\n  }\n\n  /* Custom focus underglow transition */\n  .underglow-line {\n    width: 0%;\n    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .input-wrap:focus-within .underglow-line {\n    width: 100%;\n  }\n\n  /* Metallic button text reflection */\n  .metallic-shine {\n    position: relative;\n    overflow: hidden;\n  }\n  .metallic-shine::after {\n    content: '';\n    position: absolute;\n    top: -50%;\n    left: -150%;\n    width: 200%;\n    height: 200%;\n    background: linear-gradient(\n      115deg,\n      transparent 40%,\n      rgba(255, 255, 255, 0.2) 50%,\n      transparent 60%\n    );\n    transition: all 0.75s;\n    pointer-events: none;\n  }\n  .metallic-shine:hover::after {\n    left: 100%;\n  }\n</style>\n\n<div class=\"relative w-full h-full font-outfit text-white flex flex-col items-center justify-center bg-black\" data-kid=\"1\">\n  \n  <div class=\"absolute inset-0 bg-glow-tl opacity-50\" data-kid=\"2\"></div>\n  <div class=\"absolute inset-0 bg-glow-br opacity-50\" data-kid=\"3\"></div>\n  <div id=\"embers-container\" data-kid=\"4\"></div>\n\n  \n  <div class=\"relative z-10 w-full max-w-sm px-8 space-y-10 flex flex-col items-center\" data-kid=\"5\">\n    \n    \n    <div class=\"flex flex-col items-center space-y-4\" data-kid=\"6\">\n      <div id=\"rooster-beat\" class=\"w-24 h-24 text-[#C9A84C] rooster-glow\" data-kid=\"7\">\n        <svg viewBox=\"0 0 60 60\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full h-full\" data-kid=\"8\">\n          <circle cx=\"30\" cy=\"30\" r=\"28\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".15\" data-kid=\"9\"></circle>\n          <path d=\"M12 32C8 44 18 52 30 50c8-1 16-6 20-14 4-8 2-16-4-20\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" opacity=\".4\" data-kid=\"10\"></path>\n          <path class=\"rooster-body\" d=\"M22 18C18 12 12 14 14 20c2 4 6 4 8 2M26 16c2-6 8-6 10-2 2 4-2 6-4 4\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"11\"></path>\n          <path d=\"M12 32L4 30l6 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"12\"></path>\n          <circle class=\"rooster-eye\" cx=\"18\" cy=\"28\" r=\"1.8\" fill=\"currentColor\" opacity=\".8\" data-kid=\"13\"></circle>\n          <path d=\"M24 46c-2 6 2 10 6 8\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" data-kid=\"14\"></path>\n          <path d=\"M40 24c4-4 10-6 8-12\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"15\"></path>\n          <path d=\"M42 26c6-2 10-6 8-10\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"16\"></path>\n        </svg>\n      </div>\n      \n      <div class=\"text-center\" data-kid=\"17\">\n        <h1 class=\"text-4xl font-black tracking-tighter uppercase text-[#E8C97A] drop-shadow-[0_4px_12px_rgba(201,168,76,0.3)]\" data-kid=\"18\">\n          Gallos Gold\n        </h1>\n        <p class=\"text-[#A3A3A3] text-sm uppercase tracking-[0.4em] font-light mt-1\" data-kid=\"19\">\n          Bruno's\n        </p>\n      </div>\n    </div>\n\n    \n    <div class=\"w-full space-y-6\" data-kid=\"20\">\n      \n      \n      <div class=\"group flex flex-col space-y-2 input-wrap\" data-kid=\"21\">\n        <label class=\"text-xs uppercase tracking-widest text-[#D4D4D4]/60 font-semibold px-1\" data-kid=\"22\">Usuario</label>\n        <div class=\"relative\" data-kid=\"23\">\n          <input type=\"text\" placeholder=\"Ingrese su usuario\" class=\"w-full bg-[#1A1A1A]/30 border-b border-white/10 px-4 py-3 text-white placeholder:text-[#A3A3A3]/40 focus:outline-hidden rounded-t-sm\" data-kid=\"24\">\n          <div class=\"absolute bottom-0 left-1/2 -translate-x-1/2 h-0.5 bg-[#C9A84C] underglow-line shadow-[0_2px_10px_rgba(201,168,76,0.8)]\" data-kid=\"25\"></div>\n        </div>\n      </div>\n\n      \n      <div class=\"group flex flex-col space-y-2 input-wrap\" data-kid=\"26\">\n        <label class=\"text-xs uppercase tracking-widest text-[#D4D4D4]/60 font-semibold px-1\" data-kid=\"27\">Contraseña</label>\n        <div class=\"relative\" data-kid=\"28\">\n          <input type=\"password\" placeholder=\"••••••••\" class=\"w-full bg-[#1A1A1A]/30 border-b border-white/10 px-4 py-3 text-white placeholder:text-[#A3A3A3]/40 focus:outline-hidden rounded-t-sm\" data-kid=\"29\">\n          <div class=\"absolute bottom-0 left-1/2 -translate-x-1/2 h-0.5 bg-[#C9A84C] underglow-line shadow-[0_2px_10px_rgba(201,168,76,0.8)]\" data-kid=\"30\"></div>\n        </div>\n      </div>\n\n      \n      <button class=\"w-full mt-4 py-4 rounded-md bg-linear-to-r from-[#A8862B] via-[#E8C97A] to-[#A8862B] text-black font-bold uppercase tracking-widest text-sm shadow-[0_8px_32px_rgba(201,168,76,0.25)] hover:shadow-[0_12px_48px_rgba(201,168,76,0.4)] transition-all metallic-shine active:scale-98\" data-kid=\"31\">\n        Iniciar Sesión\n      </button>\n\n      <div class=\"text-center pt-4\" data-kid=\"32\">\n        <a href=\"#\" class=\"text-xs text-[#A3A3A3] hover:text-[#E8C97A] transition-colors tracking-wide\" data-kid=\"33\">\n          ¿Olvidaste tu acceso?\n        </a>\n      </div>\n    </div>\n\n    \n    <div class=\"pt-8 opacity-20\" data-kid=\"34\">\n      <div class=\"h-px w-24 bg-linear-to-r from-transparent via-[#C9A84C] to-transparent\" data-kid=\"35\"></div>\n    </div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"36\"></script>\n<script data-kid=\"37\">\n  // Wait for DOM\n  window.addEventListener('load', () => {\n    \n    // 1. Rooster Heartbeat Animation\n    const rooster = document.getElementById('rooster-beat');\n    gsap.to(rooster, {\n      scale: 1.05,\n      filter: 'drop-shadow(0 0 15px rgba(201, 168, 76, 0.7))',\n      duration: 0.8,\n      repeat: -1,\n      yoyo: true,\n      ease: \"power1.inOut\"\n    });\n\n    // 2. Floating Embers\n    const container = document.getElementById('embers-container');\n    const emberCount = 30;\n\n    for (let i = 0; i < emberCount; i++) {\n      createEmber();\n    }\n\n    function createEmber() {\n      const ember = document.createElement('div');\n      const size = Math.random() * 3 + 1;\n      const x = Math.random() * 100;\n      const opacity = Math.random() * 0.5 + 0.1;\n      const color = i % 2 === 0 ? '#C9A84C' : '#E8C97A';\n\n      ember.style.cssText = `\n        position: absolute;\n        width: ${size}px;\n        height: ${size}px;\n        background-color: ${color};\n        border-radius: 50%;\n        bottom: -5px;\n        left: ${x}%;\n        opacity: ${opacity};\n        filter: blur(1px);\n        box-shadow: 0 0 4px ${color};\n      `;\n      \n      container.appendChild(ember);\n      animateEmber(ember);\n    }\n\n    function animateEmber(el) {\n      const duration = Math.random() * 5 + 3;\n      const drift = (Math.random() - 0.5) * 100;\n\n      gsap.to(el, {\n        y: -innerHeight - 50,\n        x: `+=${drift}`,\n        opacity: 0,\n        duration: duration,\n        ease: \"power1.out\",\n        onComplete: () => {\n          el.remove();\n          createEmber();\n        }\n      });\n    }\n\n    // 3. Form staggered entry\n    gsap.from(\".relative.z-10 > *\", {\n      opacity: 0,\n      y: 30,\n      stagger: 0.2,\n      duration: 1,\n      ease: \"power3.out\"\n    });\n  });\n</script>",
