      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800;900&display=swap');\n\n  :root {\n    --gold-primary: #C9A84C;\n    --gold-bright: #E8C97A;\n    --gold-dark: #A8862B;\n    --bg-black: #000000;\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Outfit', sans-serif;\n    background-color: var(--bg-black);\n    color: white;\n    height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n  }\n\n  /* --- Background Elements --- */\n  .bg-base {\n    position: absolute;\n    inset: 0;\n    background-image: url('/api/local/images/shared/login_background.png');\n    background-size: cover;\n    background-position: center;\n    opacity: 0.4;\n    filter: blur(2px);\n    z-index: -2;\n  }\n\n  .bg-overlay {\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.8) 100%);\n    z-index: -1;\n  }\n\n  .diagonal-ray {\n    position: absolute;\n    top: -50%;\n    left: -50%;\n    width: 200%;\n    height: 200%;\n    background: linear-gradient(45deg, transparent 45%, rgba(201,168,76,0.05) 50%, transparent 55%);\n    transform: rotate(15deg);\n    pointer-events: none;\n    z-index: -1;\n    animation: rayMove 10s infinite linear;\n  }\n\n  @keyframes rayMove {\n    0% { transform: rotate(15deg) translateY(-10%); }\n    100% { transform: rotate(15deg) translateY(10%); }\n  }\n\n  /* --- Glassmorphism Card --- */\n  .login-card {\n    width: 90%;\n    max-width: 340px;\n    padding: 40px 24px;\n    background: rgba(10, 10, 10, 0.6);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n    border-radius: 24px;\n    position: relative;\n    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    opacity: 0;\n    transform: translateY(30px);\n  }\n\n  /* Glowing Border Effect */\n  .login-card::after {\n    content: '';\n    position: absolute;\n    inset: -1px;\n    background: linear-gradient(135deg, var(--gold-primary), transparent, var(--gold-dark), transparent, var(--gold-bright));\n    background-size: 300% 300%;\n    border-radius: 24px;\n    z-index: -1;\n    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n    mask-composite: exclude;\n    -webkit-mask-composite: destination-out;\n    opacity: 0.5;\n    animation: borderFlow 6s infinite linear;\n  }\n\n  @keyframes borderFlow {\n    0% { background-position: 0% 50%; }\n    50% { background-position: 100% 50%; }\n    100% { background-position: 0% 50%; }\n  }\n\n  /* --- Inputs --- */\n  .input-group {\n    margin-bottom: 24px;\n    position: relative;\n  }\n\n  .input-label {\n    display: block;\n    font-size: 11px;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.15em;\n    color: var(--gold-primary);\n    margin-bottom: 8px;\n    margin-left: 4px;\n  }\n\n  .input-wrapper {\n    position: relative;\n    background: rgba(255, 255, 255, 0.03);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    border-radius: 12px;\n    transition: all 0.3s ease;\n  }\n\n  .input-wrapper:focus-within {\n    border-color: var(--gold-primary);\n    background: rgba(201, 168, 76, 0.05);\n    box-shadow: 0 0 15px rgba(201, 168, 76, 0.1);\n  }\n\n  .form-input {\n    width: 100%;\n    background: transparent;\n    border: none;\n    padding: 14px 16px;\n    color: white;\n    font-size: 15px;\n    outline: none;\n    box-sizing: border-box;\n  }\n\n  .form-input::placeholder {\n    color: rgba(255, 255, 255, 0.2);\n  }\n\n  .eye-toggle {\n    position: absolute;\n    right: 14px;\n    top: 50%;\n    transform: translateY(-50%);\n    background: none;\n    border: none;\n    color: rgba(255, 255, 255, 0.3);\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* --- Button --- */\n  .btn-submit {\n    width: 100%;\n    height: 52px;\n    background: linear-gradient(135deg, var(--gold-dark), var(--gold-primary), var(--gold-bright));\n    border: none;\n    border-radius: 12px;\n    color: #000;\n    font-weight: 800;\n    font-size: 16px;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    cursor: pointer;\n    position: relative;\n    overflow: hidden;\n    margin-top: 10px;\n    transition: transform 0.2s ease, filter 0.3s ease;\n    box-shadow: 0 10px 20px -5px rgba(201, 168, 76, 0.4);\n  }\n\n  .btn-submit:active {\n    transform: scale(0.98);\n  }\n\n  /* Metallic Sweep Effect */\n  .btn-submit::after {\n    content: '';\n    position: absolute;\n    top: -50%;\n    left: -150%;\n    width: 100%;\n    height: 200%;\n    background: linear-gradient(\n      to right,\n      rgba(255, 255, 255, 0) 0%,\n      rgba(255, 255, 255, 0.6) 50%,\n      rgba(255, 255, 255, 0) 100%\n    );\n    transform: rotate(30deg);\n    animation: shine 4s infinite ease-in-out;\n  }\n\n  @keyframes shine {\n    0% { left: -150%; }\n    20% { left: 150%; }\n    100% { left: 150%; }\n  }\n\n  /* --- Logo Section --- */\n  .logo-container {\n    text-align: center;\n    margin-bottom: 32px;\n    opacity: 0;\n    transform: translateY(-20px);\n  }\n\n  .rooster-svg {\n    width: 70px;\n    height: 70px;\n    margin-bottom: 12px;\n    filter: drop-shadow(0 0 15px rgba(201, 168, 76, 0.4));\n  }\n\n  .brand-name {\n    font-size: 32px;\n    font-weight: 900;\n    background: linear-gradient(to bottom, #FFFFFF 0%, var(--gold-primary) 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    letter-spacing: -0.02em;\n    margin: 0;\n  }\n\n  .brand-tagline {\n    font-size: 12px;\n    font-weight: 400;\n    text-transform: uppercase;\n    letter-spacing: 0.4em;\n    color: var(--gold-primary);\n    margin-top: 4px;\n    opacity: 0.8;\n  }\n\n</style>\n\n<div class=\"bg-base\" data-kid=\"1\"></div>\n<div class=\"bg-overlay\" data-kid=\"2\"></div>\n<div class=\"diagonal-ray\" data-kid=\"3\"></div>\n\n<div class=\"flex flex-col items-center justify-center w-full relative z-10\" data-kid=\"4\">\n  \n  <div class=\"logo-container\" id=\"logo\" data-kid=\"5\">\n    <svg class=\"rooster-svg\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"6\">\n      <path d=\"M50 10C55 10 60 15 60 20C60 25 55 30 50 30C45 30 40 25 40 20C40 15 45 10 50 10Z\" fill=\"var(--gold-primary)\" data-kid=\"7\"></path>\n      <path d=\"M40 25L30 45C25 55 30 75 50 85C70 75 75 55 70 45L60 25H40Z\" fill=\"url(#goldGradient)\" data-kid=\"8\"></path>\n      <path d=\"M30 45C20 40 10 50 15 70C20 90 40 95 50 95C60 95 80 90 85 70C90 50 80 40 70 45\" stroke=\"var(--gold-bright)\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"9\"></path>\n      <defs data-kid=\"10\">\n        <linearGradient id=\"goldGradient\" x1=\"50\" y1=\"25\" x2=\"50\" y2=\"85\" gradientUnits=\"userSpaceOnUse\" data-kid=\"11\">\n          <stop stop-color=\"#E8C97A\" data-kid=\"12\"></stop>\n          <stop offset=\"1\" stop-color=\"#A8862B\" data-kid=\"13\"></stop>\n        </linearGradient>\n      </defs>\n    </svg>\n    <h1 class=\"brand-name\" data-kid=\"14\">Gallo Gold</h1>\n    <div class=\"brand-tagline\" data-kid=\"15\">Bruno's</div>\n  </div>\n\n  <div class=\"login-card\" id=\"card\" data-kid=\"16\">\n    <div class=\"input-group\" data-kid=\"17\">\n      <label class=\"input-label\" data-kid=\"18\">Usuario</label>\n      <div class=\"input-wrapper\" data-kid=\"19\">\n        <input type=\"text\" class=\"form-input\" placeholder=\"Tu usuario\" data-kid=\"20\">\n      </div>\n    </div>\n\n    <div class=\"input-group\" data-kid=\"21\">\n      <label class=\"input-label\" data-kid=\"22\">Contraseña</label>\n      <div class=\"input-wrapper\" data-kid=\"23\">\n        <input type=\"password\" id=\"passwordInput\" class=\"form-input\" placeholder=\"••••••••\" data-kid=\"24\">\n        <button class=\"eye-toggle\" onclick=\"togglePassword()\" data-kid=\"25\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"26\">\n            <path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\" data-kid=\"27\"></path>\n            <circle cx=\"12\" cy=\"12\" r=\"3\" data-kid=\"28\"></circle>\n          </svg>\n        </button>\n      </div>\n    </div>\n\n    <button class=\"btn-submit\" data-kid=\"29\">Entrar</button>\n    \n    <div class=\"mt-8 text-center\" data-kid=\"30\">\n      <span class=\"text-[10px] text-white/30 uppercase tracking-[0.2em]\" data-kid=\"31\">Apuestas Premium</span>\n    </div>\n  </div>\n\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"32\"></script>\n<script data-kid=\"33\">\n  window.onload = () => {\n    const tl = gsap.timeline({ defaults: { ease: \"power3.out\" } });\n\n    // Entry animation\n    tl.to(\"#logo\", { \n      opacity: 1, \n      y: 0, \n      duration: 1.2 \n    })\n    .to(\"#card\", { \n      opacity: 1, \n      y: 0, \n      duration: 1 \n    }, \"-=0.6\")\n    .from(\".input-group\", {\n      opacity: 0,\n      y: 20,\n      stagger: 0.15,\n      duration: 0.8\n    }, \"-=0.5\")\n    .from(\".btn-submit\", {\n      opacity: 0,\n      scale: 0.9,\n      duration: 0.6\n    }, \"-=0.3\");\n\n    // Floating logo animation\n    gsap.to(\".rooster-svg\", {\n      y: -8,\n      duration: 2.5,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n  };\n\n  function togglePassword() {\n    const input = document.getElementById('passwordInput');\n    input.type = input.type === 'password' ? 'text' : 'password';\n  }\n</script>",
