      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap');\n\n  :root {\n    --gold-primary: #C9A84C;\n    --gold-bright: #E8C97A;\n    --gold-dark: #A8862B;\n    --bg-black: #000000;\n    --surface-1: #0a0a0a;\n    --surface-2: #141414;\n    --border-alpha: rgba(255, 255, 255, 0.08);\n    --gold-aura: rgba(201, 168, 76, 0.15);\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Outfit', sans-serif;\n    background-color: var(--bg-black);\n    color: #FFFFFF;\n    height: 100vh;\n    display: flex;\n    overflow: hidden;\n  }\n\n  /* --- Sidebar (Glassmorphism) --- */\n  .sidebar {\n    width: 260px;\n    height: 100vh;\n    background: rgba(10, 10, 10, 0.6);\n    backdrop-filter: blur(25px);\n    -webkit-backdrop-filter: blur(25px);\n    border-right: 1px solid var(--border-alpha);\n    display: flex;\n    flex-direction: column;\n    padding: 24px 0;\n    z-index: 100;\n    transition: width 0.3s ease;\n  }\n\n  .nav-logo {\n    padding: 0 24px;\n    margin-bottom: 40px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .rooster-icon {\n    width: 32px;\n    height: 32px;\n    filter: drop-shadow(0 0 5px var(--gold-primary));\n  }\n\n  .nav-brand-text {\n    font-weight: 900;\n    font-size: 20px;\n    background: linear-gradient(to bottom, #FFF, var(--gold-primary));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    letter-spacing: -0.02em;\n  }\n\n  .nav-menu {\n    flex: 1;\n    padding: 0 12px;\n  }\n\n  .nav-item {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 12px 16px;\n    border-radius: 12px;\n    color: rgba(255, 255, 255, 0.6);\n    text-decoration: none;\n    font-weight: 500;\n    font-size: 14px;\n    margin-bottom: 4px;\n    transition: all 0.2s ease;\n  }\n\n  .nav-item:hover, .nav-item.active {\n    background: rgba(201, 168, 76, 0.1);\n    color: var(--gold-bright);\n    box-shadow: inset 0 0 0 1px rgba(201, 168, 76, 0.2);\n  }\n\n  .nav-item svg {\n    width: 18px;\n    height: 18px;\n  }\n\n  .sidebar-footer {\n    padding: 0 24px;\n    margin-top: auto;\n  }\n\n  .user-badge {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 16px 0;\n    border-top: 1px solid var(--border-alpha);\n  }\n\n  .avatar {\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: var(--surface-2);\n    border: 1px solid var(--gold-primary);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 800;\n    color: var(--gold-primary);\n  }\n\n  /* --- Main Content --- */\n  .main-content {\n    flex: 1;\n    height: 100vh;\n    overflow-y: auto;\n    position: relative;\n    padding: 32px 40px;\n  }\n\n  .bg-glow {\n    position: absolute;\n    top: -10%;\n    right: -10%;\n    width: 60%;\n    height: 60%;\n    background: radial-gradient(circle, var(--gold-aura), transparent 70%);\n    pointer-events: none;\n    z-index: -1;\n  }\n\n  .top-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 40px;\n  }\n\n  .page-title h1 {\n    margin: 0;\n    font-size: 28px;\n    font-weight: 800;\n    letter-spacing: -0.01em;\n  }\n\n  .page-title p {\n    margin: 4px 0 0;\n    color: rgba(255, 255, 255, 0.4);\n    font-size: 14px;\n    font-family: 'JetBrains Mono', monospace;\n  }\n\n  /* --- Dashboard Stats --- */\n  .stats-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 20px;\n    margin-bottom: 40px;\n  }\n\n  .stat-card {\n    background: var(--surface-1);\n    border: 1px solid var(--border-alpha);\n    border-radius: 20px;\n    padding: 24px;\n    position: relative;\n    overflow: hidden;\n    transition: all 0.3s ease;\n  }\n\n  .stat-card:hover {\n    border-color: rgba(201, 168, 76, 0.3);\n    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5), 0 0 20px var(--gold-aura);\n    transform: translateY(-4px);\n  }\n\n  .stat-card::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; width: 100%; height: 2px;\n    background: linear-gradient(90deg, transparent, var(--gold-primary), transparent);\n    opacity: 0;\n    transition: opacity 0.3s;\n  }\n\n  .stat-card:hover::before {\n    opacity: 1;\n  }\n\n  .stat-label {\n    font-size: 12px;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    color: rgba(255, 255, 255, 0.4);\n    font-weight: 700;\n    margin-bottom: 12px;\n    display: block;\n  }\n\n  .stat-value {\n    font-size: 24px;\n    font-weight: 800;\n    font-family: 'JetBrains Mono', monospace;\n    display: block;\n  }\n\n  .stat-change {\n    margin-top: 12px;\n    font-size: 12px;\n    font-weight: 600;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n\n  .stat-change.up { color: #2ECC71; }\n  .stat-change.down { color: #E74C3C; }\n\n  /* --- Premium Table --- */\n  .table-container {\n    background: var(--surface-1);\n    border: 1px solid var(--border-alpha);\n    border-radius: 24px;\n    overflow: hidden;\n    box-shadow: 0 20px 40px rgba(0,0,0,0.4);\n  }\n\n  .table-header {\n    padding: 24px;\n    border-bottom: 1px solid var(--border-alpha);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .table-header h2 {\n    margin: 0;\n    font-size: 18px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .table-header h2::before {\n    content: '';\n    width: 4px;\n    height: 18px;\n    background: var(--gold-primary);\n    border-radius: 2px;\n  }\n\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    text-align: left;\n  }\n\n  th {\n    padding: 16px 24px;\n    font-size: 11px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    color: rgba(255, 255, 255, 0.3);\n    border-bottom: 1px solid var(--border-alpha);\n    background: rgba(255, 255, 255, 0.02);\n  }\n\n  td {\n    padding: 16px 24px;\n    font-size: 14px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.03);\n    transition: background 0.2s ease;\n  }\n\n  tr:hover td {\n    background: rgba(201, 168, 76, 0.03);\n  }\n\n  .badge {\n    padding: 4px 10px;\n    border-radius: 8px;\n    font-size: 10px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n\n  .badge-active { background: rgba(46, 204, 113, 0.1); color: #2ECC71; border: 1px solid rgba(46, 204, 113, 0.2); }\n  .badge-waiting { background: rgba(201, 168, 76, 0.1); color: var(--gold-bright); border: 1px solid rgba(201, 168, 76, 0.2); }\n  .badge-closed { background: rgba(255, 255, 255, 0.05); color: rgba(255, 255, 255, 0.4); border: 1px solid rgba(255, 255, 255, 0.1); }\n\n  .txt-mono { font-family: 'JetBrains Mono', monospace; font-weight: 700; }\n  .txt-gold { color: var(--gold-bright); }\n  .txt-red { color: #E74C3C; }\n  .txt-green { color: #2ECC71; }\n\n  .bar-mini {\n    width: 100px;\n    height: 6px;\n    background: rgba(255, 255, 255, 0.05);\n    border-radius: 3px;\n    overflow: hidden;\n    display: flex;\n    margin-top: 4px;\n  }\n\n  .bar-mini-red { height: 100%; background: #C0392B; }\n  .bar-mini-green { height: 100%; background: #1A8A4A; }\n\n  /* --- Responsive Adjustments --- */\n  @media (max-width: 1024px) {\n    .sidebar { width: 80px; }\n    .nav-brand-text, .nav-label, .nav-u-info { display: none; }\n    .nav-logo, .nav-item { justify-content: center; padding: 12px; }\n    .nav-item svg { width: 22px; height: 22px; }\n    .stats-grid { grid-template-columns: repeat(2, 1fr); }\n  }\n\n  @media (max-width: 768px) {\n    .sidebar { display: none; }\n    .main-content { padding: 20px; }\n    .stats-grid { grid-template-columns: 1fr; }\n    .table-container { overflow-x: auto; }\n    table { min-width: 800px; }\n  }\n\n</style>\n\n\n<div class=\"bg-glow\" data-kid=\"1\"></div>\n\n\n<aside class=\"sidebar\" id=\"sidebar\" data-kid=\"2\">\n  <div class=\"nav-logo\" data-kid=\"3\">\n    <svg class=\"rooster-icon\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"4\">\n      <path d=\"M50 15C40 15 30 20 25 30C20 40 22 55 35 65C40 70 60 70 65 65C78 55 80 40 75 30C70 20 60 15 50 15Z\" fill=\"var(--gold-primary)\" opacity=\"0.2\" data-kid=\"5\"></path>\n      <path d=\"M30 45L20 40L25 50M70 45L80 40L75 50M50 25V15M45 20L55 20\" stroke=\"var(--gold-primary)\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"6\"></path>\n      <circle cx=\"50\" cy=\"45\" r=\"5\" fill=\"var(--gold-bright)\" data-kid=\"7\"></circle>\n      <path d=\"M25 60C20 75 35 85 50 82C65 85 80 75 75 60\" stroke=\"var(--gold-primary)\" stroke-width=\"2.5\" stroke-linecap=\"round\" data-kid=\"8\"></path>\n    </svg>\n    <span class=\"nav-brand-text\" data-kid=\"9\">Gallo Gold</span>\n  </div>\n\n  <nav class=\"nav-menu\" data-kid=\"10\">\n    <a href=\"#\" class=\"nav-item active\" data-kid=\"11\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"12\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" data-kid=\"13\"></rect><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" data-kid=\"14\"></rect><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" data-kid=\"15\"></rect><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" data-kid=\"16\"></rect></svg>\n      <span class=\"nav-label\" data-kid=\"17\">Panel</span>\n    </a>\n    <a href=\"#\" class=\"nav-item\" data-kid=\"18\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"19\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\" data-kid=\"20\"></path><circle cx=\"12\" cy=\"12\" r=\"3\" data-kid=\"21\"></circle></svg>\n      <span class=\"nav-label\" data-kid=\"22\">Fichas</span>\n    </a>\n    <a href=\"#\" class=\"nav-item\" data-kid=\"23\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"24\"><circle cx=\"12\" cy=\"12\" r=\"10\" data-kid=\"25\"></circle><path d=\"M12 6v6l4 2\" data-kid=\"26\"></path></svg>\n      <span class=\"nav-label\" data-kid=\"27\">Peleas</span>\n    </a>\n    <a href=\"#\" class=\"nav-item\" data-kid=\"28\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"29\"><path d=\"M18 20V10M12 20V4M6 20v-6\" data-kid=\"30\"></path></svg>\n      <span class=\"nav-label\" data-kid=\"31\">Corte Semanal</span>\n    </a>\n    <a href=\"#\" class=\"nav-item\" data-kid=\"32\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"33\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\" data-kid=\"34\"></path><polyline points=\"14 2 14 8 20 8\" data-kid=\"35\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\" data-kid=\"36\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\" data-kid=\"37\"></line></svg>\n      <span class=\"nav-label\" data-kid=\"38\">Auditoría</span>\n    </a>\n  </nav>\n\n  <div class=\"sidebar-footer\" data-kid=\"39\">\n    <div class=\"user-badge\" data-kid=\"40\">\n      <div class=\"avatar\" data-kid=\"41\">BG</div>\n      <div class=\"nav-u-info\" data-kid=\"42\">\n        <div style=\"font-size: 14px; font-weight: 700;\" data-kid=\"43\">Bruno G.</div>\n        <div style=\"font-size: 11px; color: rgba(255,255,255,0.4);\" data-kid=\"44\">Admin</div>\n      </div>\n    </div>\n  </div>\n</aside>\n\n\n<main class=\"main-content\" data-kid=\"45\">\n  \n  <header class=\"top-header\" data-kid=\"46\">\n    <div class=\"page-title\" data-kid=\"47\">\n      <h1 data-kid=\"48\">Dashboard Principal</h1>\n      <p data-kid=\"49\">LUNES, 22 DE JUNIO DE 2026</p>\n    </div>\n    \n    <div class=\"flex items-center gap-4\" data-kid=\"50\">\n      <button class=\"bg-surface-2 p-3 rounded-xl border border-border-alpha hover:border-gold-primary transition-colors\" data-kid=\"51\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"52\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\" data-kid=\"53\"></path><path d=\"M13.73 21a2 2 0 0 1-3.46 0\" data-kid=\"54\"></path></svg>\n      </button>\n      <div class=\"h-10 w-[1px] bg-border-alpha\" data-kid=\"55\"></div>\n      <button class=\"flex items-center gap-2 bg-gold-primary text-black px-5 py-2.5 rounded-xl font-bold hover:brightness-110 transition-all\" data-kid=\"56\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"57\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" data-kid=\"58\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" data-kid=\"59\"></line></svg>\n        Nueva Pelea\n      </button>\n    </div>\n  </header>\n\n  \n  <section class=\"stats-grid\" data-kid=\"60\">\n    <div class=\"stat-card\" data-kid=\"61\">\n      <span class=\"stat-label\" data-kid=\"62\">En Juego Total</span>\n      <span class=\"stat-value\" data-kid=\"63\">$142,500.00</span>\n      <div class=\"stat-change up\" data-kid=\"64\">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"65\"><polyline points=\"23 6 13.5 15.5 8.5 10.5 1 18\" data-kid=\"66\"></polyline><polyline points=\"17 6 23 6 23 12\" data-kid=\"67\"></polyline></svg>\n        +12.5%\n      </div>\n    </div>\n    <div class=\"stat-card\" data-kid=\"68\">\n      <span class=\"stat-label\" data-kid=\"69\">Peleas Hoy</span>\n      <span class=\"stat-value\" data-kid=\"70\">24</span>\n      <div class=\"stat-change up\" data-kid=\"71\">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"72\"><polyline points=\"23 6 13.5 15.5 8.5 10.5 1 18\" data-kid=\"73\"></polyline><polyline points=\"17 6 23 6 23 12\" data-kid=\"74\"></polyline></svg>\n        4 Activas\n      </div>\n    </div>\n    <div class=\"stat-card\" data-kid=\"75\">\n      <span class=\"stat-label\" data-kid=\"76\">Comisión Casa</span>\n      <span class=\"stat-value\" data-kid=\"77\">$14,250.00</span>\n      <div class=\"stat-change up\" data-kid=\"78\">\n        <span class=\"txt-gold\" data-kid=\"79\">10% Neto</span>\n      </div>\n    </div>\n    <div class=\"stat-card\" data-kid=\"80\">\n      <span class=\"stat-label\" data-kid=\"81\">Apostadores</span>\n      <span class=\"stat-value\" data-kid=\"82\">128</span>\n      <div class=\"stat-change up\" data-kid=\"83\">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"84\"><polyline points=\"23 6 13.5 15.5 8.5 10.5 1 18\" data-kid=\"85\"></polyline><polyline points=\"17 6 23 6 23 12\" data-kid=\"86\"></polyline></svg>\n        +8 nuevos\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"table-container\" data-kid=\"87\">\n    <div class=\"table-header\" data-kid=\"88\">\n      <h2 data-kid=\"89\">Peleas del Día</h2>\n      <div class=\"flex gap-2\" data-kid=\"90\">\n        <button class=\"bg-surface-2 px-4 py-2 rounded-lg text-xs font-bold border border-border-alpha\" data-kid=\"91\">VER TODAS</button>\n        <button class=\"bg-surface-2 px-4 py-2 rounded-lg text-xs font-bold border border-gold-primary text-gold-bright\" data-kid=\"92\">EXPORTAR PDF</button>\n      </div>\n    </div>\n    \n    <table data-kid=\"93\">\n      <thead data-kid=\"94\">\n        <tr data-kid=\"95\">\n          <th data-kid=\"96\"># Pelea</th>\n          <th data-kid=\"97\">Estado</th>\n          <th data-kid=\"98\">Monto Total</th>\n          <th data-kid=\"99\">Bando Rojo</th>\n          <th data-kid=\"100\">Bando Verde</th>\n          <th data-kid=\"101\">Pago Proyectado</th>\n        </tr>\n      </thead>\n      <tbody data-kid=\"102\">\n        <tr data-kid=\"103\">\n          <td class=\"txt-mono\" data-kid=\"104\">#042</td>\n          <td data-kid=\"105\"><span class=\"badge badge-active\" data-kid=\"106\">En Juego</span></td>\n          <td class=\"txt-mono\" data-kid=\"107\">$24,000.00</td>\n          <td data-kid=\"108\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"109\">\n              <span class=\"txt-mono txt-red\" data-kid=\"110\">45%</span>\n              <div class=\"bar-mini\" data-kid=\"111\"><div class=\"bar-mini-red\" style=\"width: 45%;\" data-kid=\"112\"></div></div>\n            </div>\n          </td>\n          <td data-kid=\"113\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"114\">\n              <span class=\"txt-mono txt-green\" data-kid=\"115\">55%</span>\n              <div class=\"bar-mini\" data-kid=\"116\"><div class=\"bar-mini-green\" style=\"width: 55%;\" data-kid=\"117\"></div></div>\n            </div>\n          </td>\n          <td class=\"txt-mono txt-gold\" data-kid=\"118\">$13,200.00</td>\n        </tr>\n        <tr data-kid=\"119\">\n          <td class=\"txt-mono\" data-kid=\"120\">#043</td>\n          <td data-kid=\"121\"><span class=\"badge badge-waiting\" data-kid=\"122\">Abierta</span></td>\n          <td class=\"txt-mono\" data-kid=\"123\">$8,500.00</td>\n          <td data-kid=\"124\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"125\">\n              <span class=\"txt-mono txt-red\" data-kid=\"126\">30%</span>\n              <div class=\"bar-mini\" data-kid=\"127\"><div class=\"bar-mini-red\" style=\"width: 30%;\" data-kid=\"128\"></div></div>\n            </div>\n          </td>\n          <td data-kid=\"129\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"130\">\n              <span class=\"txt-mono txt-green\" data-kid=\"131\">70%</span>\n              <div class=\"bar-mini\" data-kid=\"132\"><div class=\"bar-mini-green\" style=\"width: 70%;\" data-kid=\"133\"></div></div>\n            </div>\n          </td>\n          <td class=\"txt-mono txt-gold\" data-kid=\"134\">$7,650.00</td>\n        </tr>\n        <tr data-kid=\"135\">\n          <td class=\"txt-mono\" data-kid=\"136\">#041</td>\n          <td data-kid=\"137\"><span class=\"badge badge-closed\" data-kid=\"138\">Cerrada</span></td>\n          <td class=\"txt-mono\" data-kid=\"139\">$42,000.00</td>\n          <td data-kid=\"140\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"141\">\n              <span class=\"txt-mono txt-red\" data-kid=\"142\">50%</span>\n              <div class=\"bar-mini\" data-kid=\"143\"><div class=\"bar-mini-red\" style=\"width: 50%;\" data-kid=\"144\"></div></div>\n            </div>\n          </td>\n          <td data-kid=\"145\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"146\">\n              <span class=\"txt-mono txt-green\" data-kid=\"147\">50%</span>\n              <div class=\"bar-mini\" data-kid=\"148\"><div class=\"bar-mini-green\" style=\"width: 50%;\" data-kid=\"149\"></div></div>\n            </div>\n          </td>\n          <td class=\"txt-mono opacity-40\" data-kid=\"150\">$21,000.00</td>\n        </tr>\n        <tr data-kid=\"151\">\n          <td class=\"txt-mono\" data-kid=\"152\">#040</td>\n          <td data-kid=\"153\"><span class=\"badge badge-closed\" data-kid=\"154\">Cerrada</span></td>\n          <td class=\"txt-mono\" data-kid=\"155\">$15,200.00</td>\n          <td data-kid=\"156\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"157\">\n              <span class=\"txt-mono txt-red\" data-kid=\"158\">65%</span>\n              <div class=\"bar-mini\" data-kid=\"159\"><div class=\"bar-mini-red\" style=\"width: 65%;\" data-kid=\"160\"></div></div>\n            </div>\n          </td>\n          <td data-kid=\"161\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"162\">\n              <span class=\"txt-mono txt-green\" data-kid=\"163\">35%</span>\n              <div class=\"bar-mini\" data-kid=\"164\"><div class=\"bar-mini-green\" style=\"width: 35%;\" data-kid=\"165\"></div></div>\n            </div>\n          </td>\n          <td class=\"txt-mono opacity-40\" data-kid=\"166\">$9,880.00</td>\n        </tr>\n      </tbody>\n    </table>\n  </section>\n\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"167\"></script>\n<script data-kid=\"168\">\n  window.addEventListener('DOMContentLoaded', () => {\n    const tl = gsap.timeline({ defaults: { ease: \"power3.out\" } });\n\n    // Entry animations\n    tl.from(\"#sidebar\", { x: -260, duration: 1 })\n      .from(\".page-title h1, .page-title p\", { opacity: 0, y: 20, stagger: 0.2, duration: 0.8 }, \"-=0.5\")\n      .from(\".stat-card\", { opacity: 0, scale: 0.9, stagger: 0.1, duration: 0.6 }, \"-=0.4\")\n      .from(\".table-container\", { opacity: 0, y: 40, duration: 1 }, \"-=0.3\");\n\n    // Aura animation\n    gsap.to(\".bg-glow\", {\n      opacity: 0.6,\n      scale: 1.1,\n      duration: 5,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n  });\n</script>",
