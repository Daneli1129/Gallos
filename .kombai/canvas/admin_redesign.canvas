      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap');\n\n  :root {\n    --gold: #C9A84C;\n    --gold-bright: #E8C97A;\n    --gold-dark: #A8862B;\n    --bg-black: #000000;\n    --surface: #0a0a0a;\n    --surface-light: #141414;\n    --border: rgba(201, 168, 76, 0.12);\n    --text-muted: #A3A3A3;\n  }\n\n  body {\n    background-color: var(--bg-black);\n    color: white;\n    font-family: 'Outfit', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  /* Grain Texture Overlay */\n  .noise-overlay {\n    position: fixed;\n    inset: 0;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    opacity: 0.03;\n    pointer-events: none;\n    z-index: 50;\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 6px; }\n  ::-webkit-scrollbar-track { background: var(--bg-black); }\n  ::-webkit-scrollbar-thumb { background: var(--surface-light); border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: var(--gold-dark); }\n\n  /* Sidebar Accents */\n  .sidebar-accent {\n    position: absolute;\n    right: 0;\n    top: 0;\n    bottom: 0;\n    width: 1px;\n    background: linear-gradient(180deg, transparent, var(--gold), transparent);\n    opacity: 0.3;\n  }\n\n  /* Table Styles */\n  .table-row {\n    border-bottom: 1px solid var(--border);\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .table-row:hover {\n    background: rgba(201, 168, 76, 0.03);\n  }\n  .table-row.active {\n    background: rgba(201, 168, 76, 0.05);\n    border-left: 2px solid var(--gold);\n  }\n\n  .status-pill {\n    padding: 2px 8px;\n    border-radius: 99px;\n    font-size: 10px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n  .status-activa { background: rgba(46, 204, 113, 0.15); color: #2ECC71; border: 1px solid rgba(46, 204, 113, 0.3); }\n  .status-espera { background: rgba(201, 168, 76, 0.15); color: var(--gold-bright); border: 1px solid rgba(201, 168, 76, 0.3); }\n\n  /* Expanded Content */\n  .expanded-content {\n    max-height: 0;\n    overflow: hidden;\n    background: rgba(0, 0, 0, 0.4);\n    transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .table-row.active + .expanded-content {\n    max-height: 500px;\n  }\n\n  /* Button Shine */\n  .btn-gold {\n    background: linear-gradient(135deg, var(--gold-dark), var(--gold), var(--gold-bright));\n    position: relative;\n    overflow: hidden;\n    transition: transform 0.2s;\n  }\n  .btn-gold:hover { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(201, 168, 76, 0.3); }\n  .btn-gold::after {\n    content: '';\n    position: absolute;\n    top: -50%;\n    left: -150%;\n    width: 100%;\n    height: 200%;\n    background: linear-gradient(to right, transparent, rgba(255,255,255,0.4), transparent);\n    transform: rotate(30deg);\n    animation: shine 4s infinite linear;\n  }\n  @keyframes shine {\n    0% { left: -150%; }\n    20% { left: 150%; }\n    100% { left: 150%; }\n  }\n\n  /* Rooster Wing Animation */\n  .wing-left { transform-origin: 30px 30px; }\n  .wing-right { transform-origin: 30px 30px; }\n\n  @media (max-width: 1024px) {\n    .sidebar { width: 80px; }\n    .nav-label { display: none; }\n    .nav-logo-text { display: none; }\n    .col-hide-tablet { display: none; }\n  }\n</style>\n\n<div class=\"noise-overlay\" data-kid=\"1\"></div>\n\n<div class=\"flex h-screen w-full\" data-kid=\"2\">\n  \n  <aside class=\"sidebar w-[280px] bg-[var(--surface)] relative flex flex-col shrink-0\" data-kid=\"3\">\n    <div class=\"sidebar-accent\" data-kid=\"4\"></div>\n    \n    \n    <div class=\"p-8 flex items-center gap-4\" data-kid=\"5\">\n      <div id=\"rooster-logo\" class=\"w-10 h-10 shrink-0\" data-kid=\"6\">\n        <svg viewBox=\"0 0 60 60\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full h-full text-[var(--gold)] drop-shadow-[0_0_8px_rgba(201,168,76,0.4)]\" data-kid=\"7\">\n          \n          <path class=\"rooster-body\" d=\"M30 45C35 45 38 40 38 35C38 30 35 25 30 25C25 25 22 30 22 35C22 40 25 45 30 45Z\" fill=\"currentColor\" data-kid=\"8\"></path>\n          \n          <path d=\"M30 25C30 20 25 15 20 18C15 21 18 28 22 25\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"9\"></path>\n          <path d=\"M22 15C22 12 25 10 28 12\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"10\"></path>\n          \n          <path class=\"wing-left\" d=\"M22 35C15 30 5 35 10 45C15 50 22 40 22 35Z\" fill=\"currentColor\" opacity=\"0.8\" data-kid=\"11\"></path>\n          <path class=\"wing-right\" d=\"M38 35C45 30 55 35 50 45C45 50 38 40 38 35Z\" fill=\"currentColor\" opacity=\"0.8\" data-kid=\"12\"></path>\n          \n          <path d=\"M27 45L25 52M33 45L35 52\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" data-kid=\"13\"></path>\n        </svg>\n      </div>\n      <div class=\"nav-logo-text\" data-kid=\"14\">\n        <h1 class=\"text-lg font-black tracking-tighter text-white uppercase leading-none\" data-kid=\"15\">Gallo Gold</h1>\n        <p class=\"text-[10px] tracking-[0.4em] text-[var(--gold)] uppercase font-bold opacity-80\" data-kid=\"16\">Bruno's</p>\n      </div>\n    </div>\n\n    \n    <nav class=\"flex-1 px-4 py-4 flex flex-col gap-2\" data-kid=\"17\">\n      <a href=\"#\" class=\"flex items-center gap-4 px-4 py-3 rounded-xl bg-white/5 text-[var(--gold)] border border-[var(--gold)]/20\" data-kid=\"18\">\n        <i class=\"ti ti-sword\" data-kid=\"19\"></i>\n        <span class=\"nav-label font-bold text-sm\" data-kid=\"20\">Peleas</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-4 py-3 rounded-xl text-[var(--text-muted)] hover:bg-white/5 transition-colors\" data-kid=\"21\">\n        <i class=\"ti ti-users\" data-kid=\"22\"></i>\n        <span class=\"nav-label font-bold text-sm\" data-kid=\"23\">Jugadores</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-4 py-3 rounded-xl text-[var(--text-muted)] hover:bg-white/5 transition-colors\" data-kid=\"24\">\n        <i class=\"ti ti-layout-dashboard\" data-kid=\"25\"></i>\n        <span class=\"nav-label font-bold text-sm\" data-kid=\"26\">Dashboard</span>\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-4 py-3 rounded-xl text-[var(--text-muted)] hover:bg-white/5 transition-colors\" data-kid=\"27\">\n        <i class=\"ti ti-file-text\" data-kid=\"28\"></i>\n        <span class=\"nav-label font-bold text-sm\" data-kid=\"29\">Auditoría</span>\n      </a>\n    </nav>\n\n    \n    <div class=\"p-6 border-t border-[var(--border)]\" data-kid=\"30\">\n      <div class=\"flex items-center gap-3\" data-kid=\"31\">\n        <div class=\"w-10 h-10 rounded-full bg-[var(--surface-light)] border border-[var(--gold)]/30 flex items-center justify-center font-black text-[var(--gold)]\" data-kid=\"32\">BG</div>\n        <div class=\"nav-label\" data-kid=\"33\">\n          <p class=\"text-sm font-bold\" data-kid=\"34\">Bruno G.</p>\n          <p class=\"text-[10px] text-[var(--text-muted)] uppercase tracking-widest font-bold\" data-kid=\"35\">Admin</p>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 flex flex-col min-w-0 bg-[var(--bg-black)]\" data-kid=\"36\">\n    \n    <header class=\"h-20 flex items-center justify-between px-10 border-b border-[var(--border)]\" data-kid=\"37\">\n      <div class=\"flex items-center gap-4\" data-kid=\"38\">\n        <h2 class=\"text-2xl font-black tracking-tight uppercase\" data-kid=\"39\">Control de Peleas</h2>\n        <div class=\"px-3 py-1 bg-[var(--surface-light)] border border-[var(--border)] rounded-full text-[10px] font-bold text-[var(--text-muted)] tracking-widest uppercase\" data-kid=\"40\">12 Activas</div>\n      </div>\n      \n      <div class=\"flex items-center gap-6\" data-kid=\"41\">\n        <div class=\"relative\" data-kid=\"42\">\n          <input type=\"text\" placeholder=\"Buscar pelea...\" class=\"bg-[var(--surface)] border border-[var(--border)] rounded-xl py-2 px-10 text-sm focus:outline-none focus:border-[var(--gold)] transition-colors w-64\" data-kid=\"43\">\n          <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-[var(--text-muted)]\" data-kid=\"44\"></i>\n        </div>\n        <button class=\"btn-gold px-6 py-2.5 rounded-xl text-black font-black text-xs uppercase tracking-widest\" data-kid=\"45\">\n          Nuevo Evento\n        </button>\n      </div>\n    </header>\n\n    \n    <div class=\"flex-1 p-10 overflow-y-auto\" data-kid=\"46\">\n      <div class=\"w-full bg-[var(--surface)] border border-[var(--border)] rounded-2xl overflow-hidden shadow-2xl\" data-kid=\"47\">\n        \n        <div class=\"grid grid-cols-[80px_1fr_1fr_1fr_1fr_100px] gap-4 px-8 py-5 border-b border-[var(--border)] bg-white/2 opacity-60\" data-kid=\"48\">\n          <div class=\"text-[10px] font-black uppercase tracking-[0.2em] font-mono\" data-kid=\"49\">ID</div>\n          <div class=\"text-[10px] font-black uppercase tracking-[0.2em]\" data-kid=\"50\">Estado</div>\n          <div class=\"text-[10px] font-black uppercase tracking-[0.2em]\" data-kid=\"51\">Volumen Rojo</div>\n          <div class=\"text-[10px] font-black uppercase tracking-[0.2em]\" data-kid=\"52\">Volumen Verde</div>\n          <div class=\"text-[10px] font-black uppercase tracking-[0.2em]\" data-kid=\"53\">Total en Juego</div>\n          <div class=\"text-right text-[10px] font-black uppercase tracking-[0.2em]\" data-kid=\"54\">Acción</div>\n        </div>\n\n        \n        <div id=\"peleas-list\" data-kid=\"55\">\n          \n          <div class=\"table-group\" data-kid=\"56\">\n            <div class=\"table-row grid grid-cols-[80px_1fr_1fr_1fr_1fr_100px] gap-4 px-8 py-6 items-center cursor-pointer\" onclick=\"this.parentElement.classList.toggle('active'); this.classList.toggle('active')\" data-kid=\"57\">\n              <div class=\"font-mono font-black text-[var(--gold)]\" data-kid=\"58\">#124</div>\n              <div data-kid=\"59\"><span class=\"status-pill status-activa\" data-kid=\"60\">Activa</span></div>\n              <div class=\"font-mono text-sm font-bold text-red-400\" data-kid=\"61\">$45,200.00</div>\n              <div class=\"font-mono text-sm font-bold text-green-400\" data-kid=\"62\">$38,150.00</div>\n              <div class=\"font-mono text-base font-black text-white\" data-kid=\"63\">$83,350.00</div>\n              <div class=\"text-right\" data-kid=\"64\"><i class=\"ti ti-chevron-down text-[var(--gold)] opacity-50\" data-kid=\"65\"></i></div>\n            </div>\n            <div class=\"expanded-content\" data-kid=\"66\">\n              <div class=\"px-10 py-8 bg-black/20 border-b border-[var(--border)] grid grid-cols-2 gap-10\" data-kid=\"67\">\n                \n                <div data-kid=\"68\">\n                  <h4 class=\"text-[10px] font-black text-red-400 uppercase tracking-widest mb-4 flex items-center gap-2\" data-kid=\"69\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-red-400\" data-kid=\"70\"></span>\n                    Apuestas Bando Rojo\n                  </h4>\n                  <div class=\"space-y-3\" data-kid=\"71\">\n                    <div class=\"flex items-center justify-between p-3 bg-white/3 rounded-xl border border-white/5\" data-kid=\"72\">\n                      <span class=\"text-sm font-bold text-white/80\" data-kid=\"73\">Picuni</span>\n                      <span class=\"font-mono text-sm font-black\" data-kid=\"74\">$12,000.00</span>\n                    </div>\n                    <div class=\"flex items-center justify-between p-3 bg-white/3 rounded-xl border border-white/5\" data-kid=\"75\">\n                      <span class=\"text-sm font-bold text-white/80\" data-kid=\"76\">Heri</span>\n                      <span class=\"font-mono text-sm font-black\" data-kid=\"77\">$25,000.00</span>\n                    </div>\n                    <div class=\"flex items-center justify-between p-3 bg-white/3 rounded-xl border border-white/5\" data-kid=\"78\">\n                      <span class=\"text-sm font-bold text-white/80\" data-kid=\"79\">Maldonado</span>\n                      <span class=\"font-mono text-sm font-black\" data-kid=\"80\">$8,200.00</span>\n                    </div>\n                  </div>\n                </div>\n                \n                <div data-kid=\"81\">\n                  <h4 class=\"text-[10px] font-black text-green-400 uppercase tracking-widest mb-4 flex items-center gap-2\" data-kid=\"82\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-green-400\" data-kid=\"83\"></span>\n                    Apuestas Bando Verde\n                  </h4>\n                  <div class=\"space-y-3\" data-kid=\"84\">\n                    <div class=\"flex items-center justify-between p-3 bg-white/3 rounded-xl border border-white/5\" data-kid=\"85\">\n                      <span class=\"text-sm font-bold text-white/80\" data-kid=\"86\">Jaime Sosa</span>\n                      <span class=\"font-mono text-sm font-black\" data-kid=\"87\">$30,000.00</span>\n                    </div>\n                    <div class=\"flex items-center justify-between p-3 bg-white/3 rounded-xl border border-white/5\" data-kid=\"88\">\n                      <span class=\"text-sm font-bold text-white/80\" data-kid=\"89\">Tomas</span>\n                      <span class=\"font-mono text-sm font-black\" data-kid=\"90\">$8,150.00</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"table-group\" data-kid=\"91\">\n            <div class=\"table-row grid grid-cols-[80px_1fr_1fr_1fr_1fr_100px] gap-4 px-8 py-6 items-center cursor-pointer\" onclick=\"this.parentElement.classList.toggle('active'); this.classList.toggle('active')\" data-kid=\"92\">\n              <div class=\"font-mono font-black text-[var(--gold)]\" data-kid=\"93\">#123</div>\n              <div data-kid=\"94\"><span class=\"status-pill status-espera\" data-kid=\"95\">En Espera</span></div>\n              <div class=\"font-mono text-sm font-bold text-red-400\" data-kid=\"96\">$12,000.00</div>\n              <div class=\"font-mono text-sm font-bold text-green-400\" data-kid=\"97\">$14,500.00</div>\n              <div class=\"font-mono text-base font-black text-white\" data-kid=\"98\">$26,500.00</div>\n              <div class=\"text-right\" data-kid=\"99\"><i class=\"ti ti-chevron-down text-[var(--gold)] opacity-50\" data-kid=\"100\"></i></div>\n            </div>\n            <div class=\"expanded-content\" data-kid=\"101\">\n               <div class=\"px-10 py-8 text-center text-[var(--text-muted)] italic text-sm\" data-kid=\"102\">Cargando detalles de apuestas...</div>\n            </div>\n          </div>\n\n          \n          <div class=\"table-group\" data-kid=\"103\">\n            <div class=\"table-row grid grid-cols-[80px_1fr_1fr_1fr_1fr_100px] gap-4 px-8 py-6 items-center cursor-pointer\" onclick=\"this.parentElement.classList.toggle('active'); this.classList.toggle('active')\" data-kid=\"104\">\n              <div class=\"font-mono font-black text-[var(--gold)]\" data-kid=\"105\">#122</div>\n              <div data-kid=\"106\"><span class=\"status-pill status-activa\" data-kid=\"107\">Activa</span></div>\n              <div class=\"font-mono text-sm font-bold text-red-400\" data-kid=\"108\">$8,000.00</div>\n              <div class=\"font-mono text-sm font-bold text-green-400\" data-kid=\"109\">$12,000.00</div>\n              <div class=\"font-mono text-base font-black text-white\" data-kid=\"110\">$20,000.00</div>\n              <div class=\"text-right\" data-kid=\"111\"><i class=\"ti ti-chevron-down text-[var(--gold)] opacity-50\" data-kid=\"112\"></i></div>\n            </div>\n            <div class=\"expanded-content\" data-kid=\"113\">\n               <div class=\"px-10 py-8 text-center text-[var(--text-muted)] italic text-sm\" data-kid=\"114\">Cargando detalles de apuestas...</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </main>\n</div>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" data-kid=\"115\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js\" data-kid=\"116\"></script>\n\n<script data-kid=\"117\">\n  window.onload = () => {\n    // Majestic Rooster Wings Animation\n    gsap.to(\".wing-left\", {\n      rotation: -10,\n      duration: 1.5,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n    gsap.to(\".wing-right\", {\n      rotation: 10,\n      duration: 1.5,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n\n    // Entry Animations\n    const tl = gsap.timeline({ defaults: { ease: \"power4.out\" } });\n    \n    tl.from(\".sidebar\", { x: -280, duration: 1 })\n      .from(\".sidebar-accent\", { opacity: 0, duration: 1.5 }, \"-=0.5\")\n      .from(\"header h2\", { opacity: 0, x: -20, duration: 0.8 }, \"-=0.8\")\n      .from(\".table-row\", {\n        opacity: 0,\n        y: 20,\n        stagger: 0.1,\n        duration: 0.8\n      }, \"-=0.5\");\n  };\n</script>",
