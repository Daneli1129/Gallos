      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap');\n\n  :root {\n    --gold: #C9A84C;\n    --gold-dim: rgba(201, 168, 76, 0.1);\n    --gold-border: rgba(201, 168, 76, 0.2);\n    --bg-black: #000000;\n    --surface: #0a0a0a;\n    --surface-light: #141414;\n    --red: #C0392B;\n    --green: #1A8A4A;\n    --text-primary: #FFFFFF;\n    --text-secondary: #A3A3A3;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--bg-black);\n    color: var(--text-primary);\n    font-family: 'Outfit', sans-serif;\n    min-height: 100vh;\n    overflow-x: hidden;\n  }\n\n  /* --- Background Decoration --- */\n  .bg-motif {\n    position: fixed;\n    inset: 0;\n    background-image: url('/api/local/images/shared/login_background.png');\n    background-size: cover;\n    background-position: center;\n    opacity: 0.15;\n    filter: saturate(0.5);\n    z-index: -1;\n    pointer-events: none;\n  }\n\n  /* --- Top Navigation --- */\n  .top-nav {\n    height: 72px;\n    background: rgba(0, 0, 0, 0.8);\n    backdrop-filter: blur(16px);\n    border-bottom: 1px solid var(--gold-border);\n    display: flex;\n    align-items: center;\n    padding: 0 40px;\n    position: sticky;\n    top: 0;\n    z-index: 100;\n  }\n\n  .nav-brand {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .nav-brand h1 {\n    font-size: 20px;\n    font-weight: 900;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    margin: 0;\n    background: linear-gradient(to right, #fff, var(--gold));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .nav-links {\n    margin-left: 60px;\n    display: flex;\n    gap: 32px;\n  }\n\n  .nav-link {\n    text-decoration: none;\n    color: var(--text-secondary);\n    font-size: 14px;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    transition: color 0.3s ease;\n    cursor: pointer;\n  }\n\n  .nav-link:hover, .nav-link.active {\n    color: var(--gold);\n  }\n\n  .user-badge {\n    margin-left: auto;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 6px 16px;\n    background: var(--surface-light);\n    border: 1px solid var(--gold-border);\n    border-radius: 100px;\n  }\n\n  .avatar {\n    width: 28px;\n    height: 28px;\n    background: var(--gold);\n    color: #000;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 900;\n    font-size: 12px;\n  }\n\n  /* --- Dashboard Stats --- */\n  .dashboard-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 24px;\n    padding: 40px;\n  }\n\n  .stat-card {\n    background: var(--surface);\n    border: 1px solid var(--gold-border);\n    border-radius: 16px;\n    padding: 24px;\n    position: relative;\n    overflow: hidden;\n    transition: transform 0.3s ease, border-color 0.3s ease;\n  }\n\n  .stat-card:hover {\n    transform: translateY(-4px);\n    border-color: var(--gold);\n  }\n\n  .stat-label {\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--text-secondary);\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    margin-bottom: 8px;\n  }\n\n  .stat-value {\n    font-size: 32px;\n    font-weight: 900;\n    font-family: 'JetBrains Mono', monospace;\n  }\n\n  .stat-trend {\n    font-size: 12px;\n    margin-top: 8px;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n\n  .trend-up { color: var(--green); }\n  .trend-down { color: var(--red); }\n\n  /* Progress Bar Custom Card */\n  .market-card {\n    grid-column: span 2;\n    background: var(--surface);\n    border: 1px solid var(--gold-border);\n    border-radius: 16px;\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n\n  .market-labels {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 12px;\n  }\n\n  .market-label {\n    font-size: 12px;\n    font-weight: 800;\n    text-transform: uppercase;\n  }\n\n  .progress-container {\n    height: 12px;\n    background: rgba(255,255,255,0.05);\n    border-radius: 100px;\n    overflow: hidden;\n    display: flex;\n    border: 1px solid rgba(255,255,255,0.1);\n  }\n\n  .progress-red { background: var(--red); transition: width 1s ease-in-out; }\n  .progress-green { background: var(--green); transition: width 1s ease-in-out; }\n\n  /* --- Table Section --- */\n  .table-section {\n    padding: 0 40px 60px;\n  }\n\n  .section-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 24px;\n  }\n\n  .section-title {\n    font-size: 24px;\n    font-weight: 800;\n    margin: 0;\n  }\n\n  .table-container {\n    background: var(--surface);\n    border: 1px solid var(--gold-border);\n    border-radius: 16px;\n    overflow: hidden;\n    box-shadow: 0 20px 40px rgba(0,0,0,0.4);\n  }\n\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    text-align: left;\n  }\n\n  thead {\n    background: var(--surface-light);\n    position: sticky;\n    top: 72px;\n    z-index: 10;\n  }\n\n  th {\n    padding: 16px 24px;\n    font-size: 11px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.15em;\n    color: var(--text-secondary);\n    border-bottom: 1px solid var(--gold-border);\n  }\n\n  td {\n    padding: 20px 24px;\n    font-size: 14px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.03);\n    vertical-align: middle;\n  }\n\n  tr:hover {\n    background: linear-gradient(90deg, transparent, var(--gold-dim), transparent);\n  }\n\n  .td-num {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 700;\n    color: var(--gold);\n  }\n\n  .status-pill {\n    display: inline-flex;\n    padding: 4px 12px;\n    border-radius: 100px;\n    font-size: 10px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n\n  .status-activa { background: rgba(26, 138, 74, 0.15); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.3); }\n  .status-espera { background: rgba(201, 168, 76, 0.15); color: var(--gold); border: 1px solid var(--gold-border); }\n  .status-cerrada { background: rgba(192, 57, 43, 0.15); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.3); }\n\n  .reparto-box {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n\n  .reparto-item {\n    font-size: 11px;\n    display: flex;\n    justify-content: space-between;\n    width: 140px;\n  }\n\n  .text-red { color: #f87171; }\n  .text-green { color: #4ade80; }\n\n  /* Metallic button */\n  .action-btn {\n    background: linear-gradient(135deg, #A8862B, #C9A84C);\n    border: none;\n    padding: 8px 16px;\n    border-radius: 8px;\n    color: #000;\n    font-weight: 800;\n    font-size: 12px;\n    text-transform: uppercase;\n    cursor: pointer;\n    transition: transform 0.2s ease;\n  }\n\n  .action-btn:hover { transform: scale(1.05); }\n\n</style>\n\n<div class=\"bg-motif\" data-kid=\"1\"></div>\n\n<nav class=\"top-nav\" data-kid=\"2\">\n  <div class=\"nav-brand\" data-kid=\"3\">\n    <svg width=\"32\" height=\"32\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"4\">\n      <path d=\"M50 10L65 35H35L50 10Z\" fill=\"var(--gold)\" data-kid=\"5\"></path>\n      <circle cx=\"50\" cy=\"55\" r=\"30\" stroke=\"var(--gold)\" stroke-width=\"2\" data-kid=\"6\"></circle>\n      <path d=\"M40 50C40 50 45 45 50 45C55 45 60 50 60 50\" stroke=\"var(--gold)\" stroke-width=\"3\" stroke-linecap=\"round\" data-kid=\"7\"></path>\n    </svg>\n    <h1 data-kid=\"8\">Gallo Gold</h1>\n  </div>\n  \n  <div class=\"nav-links\" data-kid=\"9\">\n    <div class=\"nav-link active\" data-kid=\"10\">Dashboard</div>\n    <div class=\"nav-link\" data-kid=\"11\">Peleas</div>\n    <div class=\"nav-link\" data-kid=\"12\">Apostadores</div>\n    <div class=\"nav-link\" data-kid=\"13\">Finanzas</div>\n    <div class=\"nav-link\" data-kid=\"14\">Bitácora</div>\n  </div>\n\n  <div class=\"user-badge\" data-kid=\"15\">\n    <span class=\"text-[12px] font-bold text-white/60\" data-kid=\"16\">Bruno García</span>\n    <div class=\"avatar\" data-kid=\"17\">BG</div>\n  </div>\n</nav>\n\n<main data-kid=\"18\">\n  <div class=\"dashboard-grid\" data-kid=\"19\">\n    <div class=\"stat-card\" data-kid=\"20\">\n      <div class=\"stat-label\" data-kid=\"21\">Total en Juego</div>\n      <div class=\"stat-value\" id=\"val-en-juego\" data-kid=\"22\">$0</div>\n      <div class=\"stat-trend trend-up\" data-kid=\"23\">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"24\"><polyline points=\"23 6 13.5 15.5 8.5 10.5 1 18\" data-kid=\"25\"></polyline><polyline points=\"17 6 23 6 23 12\" data-kid=\"26\"></polyline></svg>\n        +12.5%\n      </div>\n    </div>\n\n    <div class=\"market-card\" data-kid=\"27\">\n      <div class=\"market-labels\" data-kid=\"28\">\n        <div class=\"market-label text-red\" data-kid=\"29\">Rojo: $42,500</div>\n        <div class=\"market-label text-green\" data-kid=\"30\">Verde: $58,200</div>\n      </div>\n      <div class=\"progress-container\" data-kid=\"31\">\n        <div class=\"progress-red\" style=\"width: 42%\" data-kid=\"32\"></div>\n        <div class=\"progress-green\" style=\"width: 58%\" data-kid=\"33\"></div>\n      </div>\n      <div class=\"mt-4 flex justify-center\" data-kid=\"34\">\n        <span class=\"text-[10px] text-white/40 font-bold tracking-[0.2em] uppercase\" data-kid=\"35\">Balance de Mercado</span>\n      </div>\n    </div>\n\n    <div class=\"stat-card\" data-kid=\"36\">\n      <div class=\"stat-label\" data-kid=\"37\">Peleas Hoy</div>\n      <div class=\"stat-value\" id=\"val-peleas\" data-kid=\"38\">0</div>\n      <div class=\"stat-trend\" data-kid=\"39\">\n        <span class=\"text-white/40\" data-kid=\"40\">7 completadas</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"table-section\" data-kid=\"41\">\n    <div class=\"section-header\" data-kid=\"42\">\n      <h2 class=\"section-title\" data-kid=\"43\">Control de Peleas</h2>\n      <div class=\"flex gap-4\" data-kid=\"44\">\n        <div class=\"px-4 py-2 bg-surface border border-gold-border rounded-lg text-xs font-bold uppercase tracking-widest text-gold-dim\" data-kid=\"45\">Filtros: Activas</div>\n        <button class=\"action-btn\" data-kid=\"46\">Nueva Pelea</button>\n      </div>\n    </div>\n\n    <div class=\"table-container\" data-kid=\"47\">\n      <table data-kid=\"48\">\n        <thead data-kid=\"49\">\n          <tr data-kid=\"50\">\n            <th data-kid=\"51\"># Pelea</th>\n            <th data-kid=\"52\">Estado</th>\n            <th data-kid=\"53\">Total Apuestas</th>\n            <th data-kid=\"54\">Volumen</th>\n            <th data-kid=\"55\">Proyección Reparto</th>\n            <th data-kid=\"56\">Acciones</th>\n          </tr>\n        </thead>\n        <tbody id=\"table-body\" data-kid=\"57\">\n          \n          <tr class=\"table-row\" data-kid=\"58\">\n            <td class=\"td-num\" data-kid=\"59\">#124</td>\n            <td data-kid=\"60\"><span class=\"status-pill status-activa\" data-kid=\"61\">En Juego</span></td>\n            <td class=\"font-bold\" data-kid=\"62\">42</td>\n            <td class=\"font-bold font-mono\" data-kid=\"63\">$18,400.00</td>\n            <td data-kid=\"64\">\n              <div class=\"reparto-box\" data-kid=\"65\">\n                <div class=\"reparto-item\" data-kid=\"66\">\n                  <span class=\"text-white/40 font-bold\" data-kid=\"67\">GANÓ ROJO</span>\n                  <span class=\"text-red font-bold\" data-kid=\"68\">$12,450</span>\n                </div>\n                <div class=\"reparto-item\" data-kid=\"69\">\n                  <span class=\"text-white/40 font-bold\" data-kid=\"70\">GANÓ VERDE</span>\n                  <span class=\"text-green font-bold\" data-kid=\"71\">$15,200</span>\n                </div>\n              </div>\n            </td>\n            <td data-kid=\"72\">\n              <button class=\"p-2 text-gold-dim hover:text-gold transition-colors\" data-kid=\"73\">\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"74\"><path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z\" data-kid=\"75\"></path><circle cx=\"12\" cy=\"12\" r=\"3\" data-kid=\"76\"></circle></svg>\n              </button>\n            </td>\n          </tr>\n          \n          <tr class=\"table-row\" data-kid=\"77\">\n            <td class=\"td-num\" data-kid=\"78\">#123</td>\n            <td data-kid=\"79\"><span class=\"status-pill status-espera\" data-kid=\"80\">Abierta</span></td>\n            <td class=\"font-bold\" data-kid=\"81\">12</td>\n            <td class=\"font-bold font-mono\" data-kid=\"82\">$5,200.00</td>\n            <td data-kid=\"83\">\n              <div class=\"reparto-box\" data-kid=\"84\">\n                <div class=\"reparto-item\" data-kid=\"85\">\n                  <span class=\"text-white/40 font-bold\" data-kid=\"86\">GANÓ ROJO</span>\n                  <span class=\"text-red font-bold\" data-kid=\"87\">$2,100</span>\n                </div>\n                <div class=\"reparto-item\" data-kid=\"88\">\n                  <span class=\"text-white/40 font-bold\" data-kid=\"89\">GANÓ VERDE</span>\n                  <span class=\"text-green font-bold\" data-kid=\"90\">$3,400</span>\n                </div>\n              </div>\n            </td>\n            <td data-kid=\"91\">\n              <button class=\"p-2 text-gold-dim hover:text-gold transition-colors\" data-kid=\"92\">\n                <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"93\"><path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z\" data-kid=\"94\"></path><circle cx=\"12\" cy=\"12\" r=\"3\" data-kid=\"95\"></circle></svg>\n              </button>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"96\"></script>\n<script data-kid=\"97\">\n  window.onload = () => {\n    const tl = gsap.timeline();\n\n    tl.from(\".stat-card\", {\n      opacity: 0,\n      y: 20,\n      stagger: 0.1,\n      duration: 0.8,\n      ease: \"power3.out\"\n    })\n    .from(\".market-card\", {\n      opacity: 0,\n      scale: 0.95,\n      duration: 0.8,\n      ease: \"power3.out\"\n    }, \"-=0.6\")\n    .from(\".table-row\", {\n      opacity: 0,\n      x: -20,\n      stagger: 0.05,\n      duration: 0.6,\n      ease: \"power2.out\"\n    }, \"-=0.4\");\n\n    // Animate values\n    const stats = { money: 0, fights: 0 };\n    gsap.to(stats, {\n      money: 100700,\n      fights: 14,\n      duration: 2,\n      ease: \"power2.out\",\n      onUpdate: () => {\n        document.getElementById('val-en-juego').textContent = '$' + Math.floor(stats.money).toLocaleString();\n        document.getElementById('val-peleas').textContent = Math.floor(stats.fights);\n      }\n    });\n  };\n</script>",
